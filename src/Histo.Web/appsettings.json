{
  "APPLICATIONINSIGHTS_CONNECTION_STRING": "__APPINSIGHTS_CONNECTION_STRING__",
  "AppSettings": {
    "ExportPath": "__EXPORT_PATH__"
  },
  "Reporting": {
    "HistologyReportRowsPerPage": 13
  },
  "ConnectionStrings": {
   // "HistologyDb": "@Microsoft.KeyVault(SecretUri=https://{vault-name}.vault.azure.net/secrets/histologydb-connection-string/)",
    "HistologyDb": "Server=tcp:devcdeinfsq1401.database.windows.net,1433;Database=histopathology;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;Authentication=Active Directory Managed Identity;"
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "__TENANT_ID__",
    "ClientId": "__CLIENT_ID__",
    // Key Vault reference in App Service settings (AzureAd__ClientSecret) — never a real value here.
    "ClientSecret": "__CLIENT_SECRET__",
    // Must match the Web redirect URI registered in the Entra ID app registration.
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc",
    // Front-channel logout URL registered in the app registration.
    "RemoteSignOutPath": "/signout-oidc",
    // Public https origin used to build redirect URIs behind the edge proxy; empty = use the request host.
    "PublicOrigin": "__PUBLIC_ORIGIN__",
    // Ask Entra ID for credentials again on every sign-in (so re-sign-in after a timeout is not silent SSO).
    "ForceLogin": true
  },
  "Session": {
    // Idle timeout in minutes for both the auth cookie and the server-side session (minimum 1).
    "IdleTimeoutMinutes": 120
  },
  "DataProtection": {
    // Optional. Set to a shared writable path to persist data-protection keys across restarts/instances.
    "KeysPath": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*"
}
