<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Histo.Web</RootNamespace>
    <UserSecretsId>histo-web-dev-secrets</UserSecretsId>
    <Description>ASP.NET Core Razor Pages web host. Replaces HistopathologySystem (64 ASPX + 8 ASCX).</Description>
    <!-- obj_copilot\ is an ad hoc -p:BaseOutputPath used to build/test around a locked bin/obj
         (see repo build notes); the default content glob only excludes bin/obj, not this folder,
         so without the exclusion its generated staticwebassets JSON gets copied in as bogus Content.
         Matched at any depth (not just project-root) since a stale copy can end up nested under bin. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj_copilot/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ITfoxtec.Identity.Saml2" Version="4.21.0" />
    <PackageReference Include="ITfoxtec.Identity.Saml2.MvcCore" Version="4.21.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />
    <PackageReference Include="Serilog.Sinks.ApplicationInsights" Version="4.0.0" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Histo.Infrastructure\Histo.Infrastructure.csproj" />
    <ProjectReference Include="..\Histo.Administration\Histo.Administration.csproj" />
    <ProjectReference Include="..\Histo.AuditLog\Histo.AuditLog.csproj" />
    <ProjectReference Include="..\Histo.QualityControl\Histo.QualityControl.csproj" />
    <ProjectReference Include="..\Histo.Histology\Histo.Histology.csproj" />
    <ProjectReference Include="..\Histo.Submissions\Histo.Submissions.csproj" />
    <ProjectReference Include="..\Histo.Reporting\Histo.Reporting.csproj" />
  </ItemGroup>

</Project>
