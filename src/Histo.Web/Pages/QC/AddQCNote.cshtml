@page
@model Histo.Web.Pages.QC.AddQCNoteModel

<p class="govuk-body"><strong>Batch No:</strong> @Model.BatchID</p>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    <li>@Model.Error</li>
                </ul>
            </div>
        </div>
    </div>
}

<form method="post">
    <div class="govuk-form-group">
        <label class="govuk-label" for="Text">Note text (optional — can also be added later via Edit)</label>
        <textarea name="Text" id="Text" class="govuk-textarea" rows="6">@Model.Text</textarea>
    </div>
    <button type="submit" class="govuk-button" data-module="govuk-button">Add QC note</button>
    <a asp-page="/QC/QCNotes" class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</a>
</form>
