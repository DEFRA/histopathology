@page
@model QCNotesModel
@{
    ViewData["Title"] = "QC Notes";
    ViewData["PageTitle"] = "Quality Control Notes";
}

<p class="govuk-body"><strong>Batch No:</strong> @Model.BatchID</p>

<form method="post" asp-page-handler="Add">
    <button type="submit" class="govuk-button" data-module="govuk-button">Add QC note</button>
</form>

@if (Model.Notes.Any())
{
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">ID</th>
                <th scope="col" class="govuk-table__header">Created by</th>
                <th scope="col" class="govuk-table__header">Date</th>
                <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Action</span></th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var n in Model.Notes)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@n.ID</td>
                    <td class="govuk-table__cell">@n.CreatedBy</td>
                    <td class="govuk-table__cell">@n.DateCreated</td>
                    <td class="govuk-table__cell">
                        <form method="post">
                            <input type="hidden" name="noteId" value="@n.ID" />
                            <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" asp-page-handler="Edit">Edit</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="govuk-body">No QC notes for this batch.</p>
}
