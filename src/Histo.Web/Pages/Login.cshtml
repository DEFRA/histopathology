@page
@model Histo.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="govuk-template">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sign in — Histopathology System</title>
    <link rel="stylesheet" href="/govuk/govuk-frontend.min.css">
</head>
<body class="govuk-template__body">
<div class="govuk-width-container">
    <main class="govuk-main-wrapper" id="main-content">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">

                <h1 class="govuk-heading-xl">Sign in</h1>

                @* BRIDGE (ADR-006): Temporary manual NTLogin entry page.
                   Decommission when Entra ID SAML ACS endpoint is live.
                   See: docs/ADR/ADR-006-manual-login-page-bridge.md *@

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="govuk-error-summary" data-module="govuk-error-summary">
                        <div role="alert">
                            <h2 class="govuk-error-summary__title">There is a problem</h2>
                            <div class="govuk-error-summary__body">
                                <ul class="govuk-list govuk-error-summary__list">
                                    <li>
                                        <a href="#ntlogin">@Model.ErrorMessage</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                }

                <form method="post" novalidate>
                    <div class="govuk-form-group @(!string.IsNullOrEmpty(Model.ErrorMessage) ? "govuk-form-group--error" : "")">
                        <label class="govuk-label govuk-label--m" for="ntlogin">
                            Windows username
                        </label>
                        <div class="govuk-hint">
                            Enter your network username, for example <strong>sd000106</strong>.
                            Do not include the domain prefix.
                        </div>
                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <p id="ntlogin-error" class="govuk-error-message">
                                <span class="govuk-visually-hidden">Error:</span>
                                @Model.ErrorMessage
                            </p>
                        }
                        <input class="govuk-input govuk-input--width-20 @(!string.IsNullOrEmpty(Model.ErrorMessage) ? "govuk-input--error" : "")"
                               id="ntlogin"
                               name="NtLogin"
                               type="text"
                               autocomplete="username"
                               spellcheck="false"
                               value="@Model.NtLogin"
                               aria-describedby="@(!string.IsNullOrEmpty(Model.ErrorMessage) ? "ntlogin-error" : "")">
                    </div>

                    <button type="submit" class="govuk-button" data-module="govuk-button">
                        Sign in
                    </button>
                </form>

            </div>
        </div>
    </main>
</div>
<script type="module" src="/govuk/govuk-frontend.min.js"></script>
<script type="module">
    import { initAll } from '/govuk/govuk-frontend.min.js'
    initAll()
</script>
</body>
</html>
