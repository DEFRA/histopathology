@*
    Shared "There is a problem" summary for the audit log search pages.
    Model = (errors, function returning the field id each error links to, or null for plain text).
*@
@model (List<string> Errors, Func<string, string?> Anchor)
@if (Model.Errors.Any())
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var e in Model.Errors)
                    {
                        var anchor = Model.Anchor(e);
                        <li>
                            @if (anchor is not null)
                            {
                                <a class="govuk-link" href="#@anchor">@e</a>
                            }
                            else
                            {
                                @e
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
}
