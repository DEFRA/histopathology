@page
@model AuditLogByUserModel
@{
    ViewData["Title"] = "Audit log by user";
    ViewData["PageTitle"] = "Audit log — by user";
}

@section BeforeHeading {
    <a asp-page="/AuditLog/AuditLogMenu" class="govuk-back-link">Back</a>
}

@if (Model.Errors.Any())
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var e in Model.Errors)
                    {
                        <li>@e</li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

<form method="post">
    <div class="govuk-form-group @(Model.Errors.Any(e => e.Contains("user")) ? "govuk-form-group--error" : "")">
        <label class="govuk-label" for="UserID">User</label>
        @if (Model.Errors.Any(e => e.Contains("user")))
        {
            <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> Select a user.</p>
        }
        <select class="govuk-select @(Model.Errors.Any(e => e.Contains("user")) ? "govuk-select--error" : "")" asp-for="UserID">
            <option value="0">-- Select user --</option>
            @foreach (var u in Model.Users)
            {
                <option value="@u.UserID">@u.Name</option>
            }
        </select>
    </div>
    <div class="govuk-form-group @(Model.Errors.Any(e => e.Contains("start")) ? "govuk-form-group--error" : "")">
        <label class="govuk-label" for="StartDate">From</label>
        @if (Model.Errors.Any(e => e.Contains("start")))
        {
            <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> Enter a start date.</p>
        }
        <input class="govuk-input govuk-input--width-10 @(Model.Errors.Any(e => e.Contains("start")) ? "govuk-input--error" : "")" type="date" asp-for="StartDate" />
    </div>
    <div class="govuk-form-group @(Model.Errors.Any(e => e.Contains("end")) ? "govuk-form-group--error" : "")">
        <label class="govuk-label" for="EndDate">To</label>
        @if (Model.Errors.Any(e => e.Contains("end")))
        {
            <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @Model.Errors.First(e => e.Contains("end"))</p>
        }
        <input class="govuk-input govuk-input--width-10 @(Model.Errors.Any(e => e.Contains("end")) ? "govuk-input--error" : "")" type="date" asp-for="EndDate" />
    </div>
    <button type="submit" class="govuk-button" data-module="govuk-button">Search</button>
    @if (Model.Results.Any())
    {
        <button type="submit" asp-page-handler="ExportCsv" class="govuk-button govuk-button--secondary" data-module="govuk-button">Export to CSV</button>
    }
</form>

@if (Model.Results.Any())
{
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                @{ ViewData["Label"] = "Table"; ViewData["Column"] = "TableName"; }
                <partial name="_SortableHeader" />
                @{ ViewData["Label"] = "Field"; ViewData["Column"] = "FieldName"; }
                <partial name="_SortableHeader" />
                @{ ViewData["Label"] = "Date/Time"; ViewData["Column"] = "ChangedAt"; }
                <partial name="_SortableHeader" />
                @{ ViewData["Label"] = "User"; ViewData["Column"] = "UserName"; }
                <partial name="_SortableHeader" />
                <th scope="col" class="govuk-table__header">Before</th>
                <th scope="col" class="govuk-table__header">After</th>
                <th scope="col" class="govuk-table__header">Reason</th>
                <th scope="col" class="govuk-table__header">Key</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var e in Model.PagedEntries)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@e.TableName</td>
                    <td class="govuk-table__cell">@e.FieldName</td>
                    <td class="govuk-table__cell">@e.ChangedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td class="govuk-table__cell">@e.UserName</td>
                    <td class="govuk-table__cell">@e.BeforeValue</td>
                    <td class="govuk-table__cell">@e.AfterValue</td>
                    <td class="govuk-table__cell">@e.Reason</td>
                    <td class="govuk-table__cell">@e.KeyID</td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Pagination" />
}
else
{
    <p class="govuk-body">No audit log entries found for this user.</p>
}
