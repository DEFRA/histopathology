@page
@model AuditLogBySubmissionModel
@{
    ViewData["Title"] = "Audit log by submission";
    ViewData["PageTitle"] = "Audit log — by submission";
}

@section BeforeHeading {
    <a asp-page="/AuditLog/AuditLogMenu" class="govuk-back-link">Back</a>
}

@if (Model.Errors.Any())
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var e in Model.Errors)
                    {
                        var anchor = e.Contains("submission", StringComparison.OrdinalIgnoreCase) ? "SubmissionID" : null;
                        <li>
                            @if (anchor is not null)
                            {
                                <a class="govuk-link" href="#@anchor">@e</a>
                            }
                            else
                            {
                                @e
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

<form method="post" id="audit-log-form">
    <div class="govuk-form-group @(Model.Errors.Any(e => e.Contains("submission")) ? "govuk-form-group--error" : "")">
        <label class="govuk-label" for="SubmissionID">Submission number</label>
        @if (Model.Errors.Any(e => e.Contains("submission")))
        {
            <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> Enter a submission number.</p>
        }
        <input class="govuk-input govuk-input--width-10 @(Model.Errors.Any(e => e.Contains("submission")) ? "govuk-input--error" : "")" type="number" asp-for="SubmissionID" />
    </div>
    <div class="govuk-form-group">
        <label class="govuk-label" for="StartDate">From</label>
        <input class="govuk-input govuk-input--width-10" type="date" asp-for="StartDate" />
    </div>
    <div class="govuk-form-group">
        <label class="govuk-label" for="EndDate">To</label>
        <input class="govuk-input govuk-input--width-10" type="date" asp-for="EndDate" />
    </div>
    <div class="govuk-button-group">
        <button type="submit" class="govuk-button" data-module="govuk-button">Search</button>
        @if (Model.Results.Any())
        {
            <button type="submit" asp-page-handler="ExportCsv" class="govuk-button govuk-button--secondary" data-module="govuk-button">Export to excel</button>
        }
    </div>
</form>

@if (Model.Results.Any())
{
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                @{ ViewData["Label"] = "Table"; ViewData["Column"] = "TableName"; ViewData["FormId"] = "audit-log-form"; ViewData["Handler"] = ""; }
                <partial name="_SortableHeaderPost" />
                @{ ViewData["Label"] = "Field"; ViewData["Column"] = "FieldName"; }
                <partial name="_SortableHeaderPost" />
                @{ ViewData["Label"] = "Date/Time"; ViewData["Column"] = "ChangedAt"; }
                <partial name="_SortableHeaderPost" />
                @{ ViewData["Label"] = "User"; ViewData["Column"] = "UserName"; }
                <partial name="_SortableHeaderPost" />
                @{ ViewData["Label"] = "Before"; ViewData["Column"] = "BeforeValue"; }
                <partial name="_SortableHeaderPost" />
                @{ ViewData["Label"] = "After"; ViewData["Column"] = "AfterValue"; }
                <partial name="_SortableHeaderPost" />
                @{ ViewData["Label"] = "Reason"; ViewData["Column"] = "Reason"; }
                <partial name="_SortableHeaderPost" />
                @{ ViewData["Label"] = "Key"; ViewData["Column"] = "KeyID"; }
                <partial name="_SortableHeaderPost" />
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var e in Model.PagedEntries)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@e.TableName</td>
                    <td class="govuk-table__cell">@e.FieldName</td>
                    <td class="govuk-table__cell">@e.ChangedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td class="govuk-table__cell">@e.UserName</td>
                    <td class="govuk-table__cell">@e.BeforeValue</td>
                    <td class="govuk-table__cell">@e.AfterValue</td>
                    <td class="govuk-table__cell">@e.Reason</td>
                    <td class="govuk-table__cell">@e.KeyID</td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_PaginationPost" />
}
else if (Model.Searched)
{
    <p class="govuk-body">No audit log entries found for this submission.</p>
}
