@page
@model Histo.Web.Pages.Archive.ArchiveBlocksModel
@{
    ViewData["Title"] = "Archive blocks";
    ViewData["PageTitle"] = "Archive blocks";
}

@section BeforeHeading {
    <a asp-page="/Archive/ArchiveMenu" class="govuk-back-link">Back</a>
}

<table class="govuk-table">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            @{ ViewData["Label"] = "Block ref"; ViewData["Column"] = "BlockRef"; }
            <partial name="_SortableHeader" />
            @{ ViewData["Label"] = "Customer ref"; ViewData["Column"] = "CustomerRef"; }
            <partial name="_SortableHeader" />
            @{ ViewData["Label"] = "Status"; ViewData["Column"] = "Status"; }
            <partial name="_SortableHeader" />
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var b in Model.PagedEntries)
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@b.BlockRef</td>
                <td class="govuk-table__cell">@b.CustomerRef</td>
                <td class="govuk-table__cell">@b.Status</td>
            </tr>
        }
        @if (!Model.Blocks.Any())
        {
            <tr class="govuk-table__row"><td colspan="3" class="govuk-table__cell">No blocks to archive.</td></tr>
        }
    </tbody>
</table>
<partial name="_Pagination" />
<a asp-page="/Archive/ArchiveMenu" class="govuk-button govuk-button--secondary" data-module="govuk-button">Back</a>
