@page
@model Histo.Web.Pages.Archive.ArchiveTissuesModel
@{
    ViewData["Title"] = "Archive Tissues";
    ViewData["PageTitle"] = "Archive Tissues";
}

<table class="govuk-table">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Sender ref</th>
            <th scope="col" class="govuk-table__header">Histology ref</th>
            <th scope="col" class="govuk-table__header">On hold</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var a in Model.Animals)
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@a.SenderRef</td>
                <td class="govuk-table__cell">@a.HistologyRef</td>
                <td class="govuk-table__cell">@(a.OnHold ? "Yes" : "No")</td>
            </tr>
        }
        @if (!Model.Animals.Any())
        {
            <tr class="govuk-table__row"><td colspan="3" class="govuk-table__cell">No tissues to archive.</td></tr>
        }
    </tbody>
</table>
<a asp-page="/Archive/ArchiveMenu" class="govuk-button govuk-button--secondary" data-module="govuk-button">Back</a>
