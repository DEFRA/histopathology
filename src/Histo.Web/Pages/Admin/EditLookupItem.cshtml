@page "{tableId:int}"
@model Histo.Web.Pages.Admin.EditLookupItemModel
@{
    ViewData["Title"] = "Edit pick list item";
    ViewData["PageTitle"] = "Edit pick list item";
}

@section BeforeHeading {
    <a asp-page="/Admin/LookupItems" asp-route-tableId="@Model.TableId" asp-route-ReturnUrl="@Model.ReturnUrl" class="govuk-back-link">Back</a>
}

<h2 class="govuk-heading-m">@Model.TableName</h2>

<partial name="_ErrorSummary" model="Model.Errors" />

<partial name="_SaveErrorSummary" model="Model.SaveError" />

<form method="post" asp-antiforgery="true">
    <input type="hidden" asp-for="TableId" />
    <input type="hidden" asp-for="ItemId" />
    <input type="hidden" asp-for="OriginalCode" />
    <input type="hidden" asp-for="ReturnUrl" />

    @* Area dropdown — only for Contacts (table 18) and Projects (table 19). Note: EditluProjects/
       EditluContacts (the real update procedures) have no @Area parameter, so a change here is
       not currently persisted — tracked as a known issue, fix pending a decision. *@
    <partial name="_LookupItemFields" model="(Histo.Web.Pages.Admin.ILookupItemForm)Model" />
    <div class="govuk-button-group">
        <button type="submit" class="govuk-button" data-module="govuk-button">Save changes</button>
        <a asp-page="/Admin/LookupItems" asp-route-tableId="@Model.TableId" class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</a>
    </div>
</form>

