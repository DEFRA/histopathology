@page "{tableId:int}"
@model Histo.Web.Pages.Admin.EditLookupItemModel
@{
    ViewData["Title"] = "Edit pick list";
    ViewData["PageTitle"] = "Edit pick list";
}

@section BeforeHeading {
    <a asp-page="/Admin/PickListMaintenance" class="govuk-back-link">Back</a>
}

<h2 class="govuk-heading-m">@Model.TableName</h2>

<form method="get" class="govuk-!-margin-bottom-4">
    <input type="hidden" name="tableId" value="@Model.TableId" />
    <div class="govuk-checkboxes" data-module="govuk-checkboxes">
        <div class="govuk-checkboxes__item">
            <input class="govuk-checkboxes__input" type="checkbox" id="showDeactivated"
                   name="ShowDeactivated" value="true"
                   @(Model.ShowDeactivated ? "checked" : "")
                   onchange="this.form.submit()" />
            <label class="govuk-label govuk-checkboxes__label" for="showDeactivated">Show deactivated items</label>
        </div>
    </div>
    <input type="hidden" name="ShowDeactivated" value="false" />
</form>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@Model.StatusMessage</p>
        </div>
    </div>
}

@if (Model.Errors.Count > 0)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var error in Model.Errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            </div>
        </div>
    </div>
}

<table class="govuk-table">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">@(Model.ShowAreaColumn ? "Area" : "Code")</th>
            <th scope="col" class="govuk-table__header">Description</th>
            <th scope="col" class="govuk-table__header">Active</th>
            <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Actions</span></th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var i in Model.Items.Where(i => Model.ShowDeactivated || i.Active))
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@(Model.ShowAreaColumn ? i.Area : (i.Code ?? i.ID.ToString()))</td>
                <td class="govuk-table__cell">@i.Name</td>
                <td class="govuk-table__cell">@(i.Active ? "Yes" : "No")</td>
                <td class="govuk-table__cell">
                    @if (Model.TableHasCodes)
                    {
                        <a asp-page="/Admin/EditLookupItem" asp-route-tableId="@Model.TableId" asp-route-itemCode="@i.Code" class="govuk-link">Edit</a>
                    }
                    else
                    {
                        <a asp-page="/Admin/EditLookupItem" asp-route-tableId="@Model.TableId" asp-route-itemId="@i.ID" class="govuk-link">Edit</a>
                    }
                </td>
            </tr>
        }
        @if (!Model.Items.Any())
        {
            <tr class="govuk-table__row"><td colspan="4" class="govuk-table__cell">No items found.</td></tr>
        }
    </tbody>
</table>

@{
    bool isEditMode = Model.ItemId is int || !string.IsNullOrEmpty(Model.OriginalCode);
}
<h2 class="govuk-heading-m">@(isEditMode ? "Edit item" : "Add item")</h2>

<form method="post">
    <input type="hidden" asp-for="TableId" />
    <input type="hidden" asp-for="ItemId" />
    <input type="hidden" asp-for="OriginalCode" />
    @if (Model.TableHasCodes)
    {
        var codeError = Model.Errors.FirstOrDefault(e => e.IndexOf("code", StringComparison.OrdinalIgnoreCase) >= 0);
        <div class="govuk-form-group @(codeError is not null ? "govuk-form-group--error" : "")">
            <label class="govuk-label" for="Code">Code</label>
            @if (codeError is not null)
            {
                <p class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @codeError</p>
            }
            <input class="govuk-input @(codeError is not null ? "govuk-input--error" : "")" asp-for="Code" maxlength="10" />
        </div>
    }
    <div class="govuk-form-group">
        <label class="govuk-label" for="Description">Description</label>
        <input class="govuk-input" asp-for="Description" maxlength="50" />
    </div>
    <div class="govuk-form-group">
        <div class="govuk-checkboxes" data-module="govuk-checkboxes">
            <div class="govuk-checkboxes__item">
                <input class="govuk-checkboxes__input" asp-for="Active" type="checkbox" />
                <label class="govuk-label govuk-checkboxes__label" for="Active">Active</label>
            </div>
        </div>
    </div>
    <button type="submit" class="govuk-button" data-module="govuk-button">@(isEditMode ? "Save changes" : "Add item")</button>
    <a asp-page="/Admin/PickListMaintenance" class="govuk-button govuk-button--secondary" data-module="govuk-button">Back to pick lists</a>
</form>
