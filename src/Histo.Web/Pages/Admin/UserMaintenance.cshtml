@page
@model Histo.Web.Pages.Admin.UserMaintenanceModel
@{
    ViewData["Title"] = "User maintenance";
    ViewData["PageTitle"] = "User maintenance";
}

@section BeforeHeading {
    @if (Model.SafeReturnUrl is not null)
    {
        <a href="@Model.SafeReturnUrl" class="govuk-back-link">Back to submission</a>
    }
    else
    {
        <a asp-page="/Index" class="govuk-back-link">Back</a>
    }
}

@if (Model.SafeReturnUrl is not null)
{
    <div class="govuk-inset-text">
        Users added or changed here appear immediately in the "Submitted by" list on the submission you were completing.
        Select <strong>Return to submission</strong> when you are finished — nothing you have already entered will be lost.
    </div>
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@Model.StatusMessage</p>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">Database error loading users</h2>
            <div class="govuk-error-summary__body">
                <p class="govuk-body"><strong>@Model.ErrorMessage</strong></p>
                <p class="govuk-body">Check the application console log for the full stack trace.</p>
            </div>
        </div>
    </div>
}

<form method="get" class="govuk-form-group">
    <input type="hidden" name="ReturnUrl" value="@Model.SafeReturnUrl" />
    <div class="govuk-checkboxes govuk-checkboxes--small">
        <div class="govuk-checkboxes__item">
            <input class="govuk-checkboxes__input" type="checkbox" id="ShowDeactivated" name="ShowDeactivated" value="true" @(Model.ShowDeactivated ? "checked" : "") onchange="this.form.submit()" />
            <label class="govuk-label govuk-checkboxes__label" for="ShowDeactivated">Show deactivated items</label>
        </div>
    </div>
    <input type="hidden" name="ShowDeactivated" value="false" />
</form>

<p class="govuk-body">
    <a asp-page="/Admin/AddUser" asp-route-returnUrl="@Model.SafeReturnUrl" class="govuk-button" data-module="govuk-button">Add user</a>
</p>

<table class="govuk-table">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            @{ ViewData["Label"] = "Name"; ViewData["Column"] = "Name"; }
            <partial name="_SortableHeader" />
            @{ ViewData["Label"] = "NT Login"; ViewData["Column"] = "NtLogin"; }
            <partial name="_SortableHeader" />
            @{ ViewData["Label"] = "Group"; ViewData["Column"] = "Group"; }
            <partial name="_SortableHeader" />
            @{ ViewData["Label"] = "Area"; ViewData["Column"] = "Area"; }
            <partial name="_SortableHeader" />
            @{ ViewData["Label"] = "Email"; ViewData["Column"] = "Email"; }
            <partial name="_SortableHeader" />
            @{ ViewData["Label"] = "Active"; ViewData["Column"] = "Active"; }
            <partial name="_SortableHeader" />
            <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Actions</span></th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var u in Model.PagedEntries)
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@u.Name</td>
                <td class="govuk-table__cell">@u.NtLogin</td>
                <td class="govuk-table__cell">@Model.ResolveGroupName(u)</td>
                <td class="govuk-table__cell">@Model.ResolveAreaName(u)</td>
                <td class="govuk-table__cell">@u.Email</td>
                <td class="govuk-table__cell">@(u.Active ? "Yes" : "No")</td>
                <td class="govuk-table__cell">
                    <a class="govuk-link" asp-page="/Admin/EditUser" asp-route-userId="@u.UserID" asp-route-returnUrl="@Model.SafeReturnUrl">Change<span class="govuk-visually-hidden"> @u.Name</span></a>
                </td>
            </tr>
        }
        @if (!Model.Users.Any())
        {
            <tr class="govuk-table__row"><td colspan="7" class="govuk-table__cell">No users found.</td></tr>
        }
    </tbody>
</table>
<partial name="_Pagination" />

@if (Model.SafeReturnUrl is not null)
{
    <a href="@Model.SafeReturnUrl" class="govuk-button govuk-button--secondary" data-module="govuk-button">Return to submission</a>
}
