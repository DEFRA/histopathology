@page
@model Histo.Web.Pages.Admin.UserMaintenanceModel
@{
    ViewData["Title"] = "User Maintenance";
    ViewData["PageTitle"] = "User Maintenance";
}

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Name</th><th>NT Login</th><th>Group</th><th>Area</th><th>Email</th><th>Active</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model.Users)
        {
            <tr>
                <td>@u.Name</td>
                <td>@u.NtLogin</td>
                <td>@u.GroupName</td>
                <td>@u.AreaName</td>
                <td>@u.Email</td>
                <td>@(u.Active ? "Yes" : "No")</td>
            </tr>
        }
        @if (!Model.Users.Any())
        {
            <tr><td colspan="6" class="text-center">No users found.</td></tr>
        }
    </tbody>
</table>
