@page
@model Histo.Web.Pages.Admin.AddUserModel
@{
    ViewData["Title"] = "Add user";
    ViewData["PageTitle"] = "Add user";
}

@section BeforeHeading {
    <a asp-page="/Admin/UserMaintenance" asp-route-returnUrl="@Model.SafeReturnUrl" asp-route-sortColumn="@Model.SortColumn" asp-route-sortDesc="@Model.SortDesc" asp-route-showDeactivated="@Model.ShowDeactivated" class="govuk-back-link">Back</a>
}

<partial name="_ErrorSummary" model="Model.Errors" />

<partial name="_SaveErrorSummary" model="Model.SaveError" />

<form method="post" asp-antiforgery="true">
    <input type="hidden" asp-for="ReturnUrl" />
    <input type="hidden" asp-for="SortColumn" />
    <input type="hidden" asp-for="SortDesc" />
    <input type="hidden" asp-for="ShowDeactivated" />
    <partial name="_UserFormFields" model="(Histo.Web.Pages.Admin.IUserFormFields)Model" />
    <div class="govuk-button-group">
        <button type="submit" class="govuk-button" data-module="govuk-button">Add user</button>
        <a asp-page="/Admin/UserMaintenance" asp-route-returnUrl="@Model.SafeReturnUrl" asp-route-sortColumn="@Model.SortColumn" asp-route-sortDesc="@Model.SortDesc" asp-route-showDeactivated="@Model.ShowDeactivated" class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</a>
    </div>
</form>
