@page
@model Histo.Web.Pages.Admin.PickListMaintenanceModel
@{
    ViewData["Title"] = "Pick list maintenance";
    ViewData["PageTitle"] = "Pick list maintenance";
}

@section BeforeHeading {
    <a asp-page="/Index" class="govuk-back-link">Back</a>
}

<table class="govuk-table">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            @{ ViewData["Label"] = "Pick list name"; ViewData["Column"] = "TableName"; }
            <partial name="_SortableHeader" />
            <th scope="col" class="govuk-table__header govuk-table__header--numeric"><span class="govuk-visually-hidden">Actions</span></th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var tableName in Model.GetPagedEntries().Select(l => l.TableName))
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@tableName</td>
                <td class="govuk-table__cell govuk-table__cell--numeric">
                    @if (tableName == "Species")
                    {
                        <a asp-page="/Admin/SpeciesItems" class="govuk-link">Edit items<span class="govuk-visually-hidden"> for @tableName</span></a>
                    }
                    else
                    {
                        <a asp-page="/Admin/LookupItems" class="govuk-link">Edit items<span class="govuk-visually-hidden"> for @tableName</span></a>
                    }
                </td>
            </tr>
        }
        @if (!Model.GetPagedEntries().Any())
        {
            <tr class="govuk-table__row"><td colspan="2" class="govuk-table__cell">No editable pick lists found.</td></tr>
        }
    </tbody>
</table>
<partial name="_Pagination" />
