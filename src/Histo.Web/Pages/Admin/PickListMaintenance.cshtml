@page
@model Histo.Web.Pages.Admin.PickListMaintenanceModel
@{
    ViewData["Title"] = "Pick List Maintenance";
    ViewData["PageTitle"] = "Pick List Maintenance";
}

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th><th>Table Name</th><th>Select SP</th><th>Insert SP</th><th>Update SP</th><th>Delete SP</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var l in Model.Lookups)
        {
            <tr>
                <td>@l.ID</td>
                <td>@l.TableName</td>
                <td>@l.SelectStoredProcedure</td>
                <td>@l.InsertStoredProcedure</td>
                <td>@l.UpdateStoredProcedure</td>
                <td>@l.DeleteStoredProcedure</td>
            </tr>
        }
        @if (!Model.Lookups.Any())
        {
            <tr><td colspan="6" class="text-center">No editable lookups found.</td></tr>
        }
    </tbody>
</table>
