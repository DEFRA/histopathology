@model Histo.Web.Pages.Admin.UserMaintenanceModel
@*
    Table + pagination for the User Maintenance grid, split into its own partial so the
    grid-pagination.js AJAX handler can re-render just this fragment (no full page reload)
    when a pagination link is clicked.
*@
<table class="govuk-table app-table--nowrap" id="user-maintenance-table">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            @{ ViewData["Label"] = "Name"; ViewData["Column"] = "Name"; }
            <partial name="_SortableHeader" />
            @{ ViewData["Label"] = "Email"; ViewData["Column"] = "Email"; }
            <partial name="_SortableHeader" />
            @{ ViewData["Label"] = "Group"; ViewData["Column"] = "Group"; }
            <partial name="_SortableHeader" />
            @{ ViewData["Label"] = "Area"; ViewData["Column"] = "Area"; }
            <partial name="_SortableHeader" />
            @{ ViewData["Label"] = "Active"; ViewData["Column"] = "Active"; }
            <partial name="_SortableHeader" />
            <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Actions</span></th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var u in Model.GetPagedEntries())
        {
            <tr class="govuk-table__row @(u.UserID == Model.FocusUserId ? "app-table__row--saved" : "")">
                <td class="govuk-table__cell">@u.Name</td>
                <td class="govuk-table__cell">@u.Email</td>
                <td class="govuk-table__cell">@Model.ResolveGroupName(u)</td>
                <td class="govuk-table__cell">@Model.ResolveAreaName(u)</td>
                <td class="govuk-table__cell">@(u.Active ? "Yes" : "No")</td>
                <td class="govuk-table__cell">
                    <a class="govuk-link" asp-page="/Admin/EditUser" asp-route-userId="@u.UserID" asp-route-returnUrl="@Model.SafeReturnUrl" asp-route-sortColumn="@Model.SortColumn" asp-route-sortDesc="@Model.SortDesc" asp-route-showDeactivated="@Model.ShowDeactivated">Change<span class="govuk-visually-hidden"> @u.Name</span></a>
                </td>
            </tr>
        }
        @if (!Model.Users.Any())
        {
            <tr class="govuk-table__row"><td colspan="6" class="govuk-table__cell">No users found.</td></tr>
        }
    </tbody>
</table>
<partial name="_Pagination" />
