@page
@model Histo.Web.Pages.Admin.AddSpeciesItemModel
@{
    ViewData["Title"] = "Add species";
    ViewData["PageTitle"] = "Add species";
}

@section BeforeHeading {
    <a asp-page="/Admin/SpeciesItems" class="govuk-back-link">Back</a>
}

<h2 class="govuk-heading-m">Species</h2>

<partial name="_ErrorSummary" model="Model.Errors" />

@if (!string.IsNullOrEmpty(Model.SaveError))
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    <li>@Model.SaveError</li>
                </ul>
            </div>
        </div>
    </div>
}

<form method="post" asp-antiforgery="true">
    <div class="govuk-form-group @(Model.Errors.ContainsKey("Species") ? "govuk-form-group--error" : "")">
        <label class="govuk-label" for="Species">Species</label>
        @if (Model.Errors.TryGetValue("Species", out var speciesError))
        {
            <p id="Species-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @speciesError</p>
        }
        <input class="govuk-input @(Model.Errors.ContainsKey("Species") ? "govuk-input--error" : "")" asp-for="Species" maxlength="20"
               aria-describedby="@(Model.Errors.ContainsKey("Species") ? "Species-error" : null)" />
    </div>
    <div class="govuk-form-group">
        <label class="govuk-label" for="CommonName">Common name</label>
        <input class="govuk-input" asp-for="CommonName" maxlength="20" />
    </div>
    <div class="govuk-button-group">
        <button type="submit" class="govuk-button" data-module="govuk-button">Add item</button>
        <a asp-page="/Admin/SpeciesItems" class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</a>
    </div>
</form>
