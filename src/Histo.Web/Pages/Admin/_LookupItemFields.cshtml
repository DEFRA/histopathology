@model Histo.Web.Pages.Admin.ILookupItemForm
@if (Model.ShowAreaColumn)
{
    <div class="govuk-form-group">
        <label class="govuk-label" for="Area">Area</label>
        <select class="govuk-select" asp-for="Area" id="Area">
            <option value="">-- Select area --</option>
            @foreach (var a in Model.UserAreas)
            {
                if (Model.Area == a.ID.ToString())
                {
                    <option value="@a.ID" selected>@a.Name</option>
                }
                else
                {
                    <option value="@a.ID">@a.Name</option>
                }
            }
        </select>
    </div>
}
@if (Model.TableHasCodes)
{
    <div class="govuk-form-group @(Model.Errors.ContainsKey("Code") ? "govuk-form-group--error" : "")">
        <label class="govuk-label" for="Code">Code</label>
        @if (Model.Errors.TryGetValue("Code", out var codeError))
        {
            <p id="Code-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @codeError</p>
        }
        <input class="govuk-input @(Model.Errors.ContainsKey("Code") ? "govuk-input--error" : "")" asp-for="Code" maxlength="10"
               aria-describedby="@(Model.Errors.ContainsKey("Code") ? "Code-error" : null)" />
    </div>
}
<div class="govuk-form-group @(Model.Errors.ContainsKey("Description") ? "govuk-form-group--error" : "")">
    <label class="govuk-label" for="Description">Description</label>
    @if (Model.Errors.TryGetValue("Description", out var descriptionError))
    {
        <p id="Description-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @descriptionError</p>
    }
    <input class="govuk-input @(Model.Errors.ContainsKey("Description") ? "govuk-input--error" : "")" asp-for="Description" maxlength="50"
           aria-describedby="@(Model.Errors.ContainsKey("Description") ? "Description-error" : null)" />
</div>
<div class="govuk-form-group">
    <div class="govuk-checkboxes" data-module="govuk-checkboxes">
        <div class="govuk-checkboxes__item">
            <input class="govuk-checkboxes__input" asp-for="Active" type="checkbox" />
            <label class="govuk-label govuk-checkboxes__label" for="Active">Active</label>
        </div>
    </div>
</div>