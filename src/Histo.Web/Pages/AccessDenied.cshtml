@page
@model Histo.Web.Pages.AccessDeniedModel
@{
    ViewData["Title"] = "Access denied";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

        <h1 class="govuk-heading-xl">Access denied</h1>

        @if (Model.Email is not null)
        {
            <p class="govuk-body">
                You signed in as <strong>@Model.Email</strong>, but that account is not set up
                in the Histopathology System.
            </p>
        }
        else
        {
            <p class="govuk-body">
                Your account is not set up in the Histopathology System.
            </p>
        }

        <p class="govuk-body">Your account may not have been created yet, or it may have been deactivated.</p>

        <p class="govuk-body">
            Contact your system administrator to request access or reactivate your account.
        </p>

    </div>
</div>