@page
@model BatchesNotReceivedModel
@{
    ViewData["Title"] = "Submissions awaiting receipt";
    ViewData["PageTitle"] = "Submissions awaiting receipt";
}

@section BeforeHeading {
    <a asp-page="/Index" class="govuk-back-link">Back</a>
}

@{ ViewData["GoErrorPlain"] = true; }
<partial name="_QuickGoForm" model="Model" />

@if (!Model.Batches.Any())
{
    <p class="govuk-body">No batches awaiting receipt.</p>
}
else
{
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <partial name="_BatchIdentityHeaders" model="false" />
                @{
                    ViewData["Label"] = "Submission date"; ViewData["Column"] = "SubmissionDate";
                }
                <partial name="_SortableHeader" />
                <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Action</span></th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var b in Model.GetPagedEntries())
            {
                <tr class="govuk-table__row">
                    <partial name="_BatchIdentityCells" model="b" />
                    <td class="govuk-table__cell">@b.SubmissionDate</td>
                    <td class="govuk-table__cell">
                        <partial name="_BatchSelectButton" model='(b.ID, "Receive", "Receive")' />
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Pagination" />
}
