@page
@model Histo.Web.Pages.Batches.BatchesForArchivingModel
@{
    ViewData["Title"] = "Batches for archiving";
    ViewData["PageTitle"] = "Batches for archiving";
}

@section BeforeHeading {
    <a asp-page="/Index" class="govuk-back-link">Back</a>
}

<div class="govuk-form-group">
    @if (!string.IsNullOrEmpty(Model.GoError))
    {
        <div class="govuk-error-summary" data-module="govuk-error-summary">
            <div role="alert">
                <h2 class="govuk-error-summary__title">There is a problem</h2>
                <div class="govuk-error-summary__body">
                    <ul class="govuk-list govuk-error-summary__list">
                        <li><a href="#QuickGoId">@Model.GoError</a></li>
                    </ul>
                </div>
            </div>
        </div>
    }
    <form method="post" asp-page-handler="Go">
        <label class="govuk-label govuk-!-display-inline" asp-for="QuickGoId">Go directly to submission number</label>
        <input class="govuk-input govuk-input--width-10 govuk-!-display-inline govuk-!-margin-left-2" type="number" asp-for="QuickGoId" min="1" />
        <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0 govuk-!-margin-left-2">Go</button>
    </form>
</div>

<table class="govuk-table">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            @{ ViewData["Label"] = "Batch ID"; ViewData["Column"] = "ID"; }
            <partial name="_SortableHeader" />
            @{ ViewData["Label"] = "Project"; ViewData["Column"] = "ProjectDescription"; }
            <partial name="_SortableHeader" />
            @{ ViewData["Label"] = "Pathologist"; ViewData["Column"] = "ContactDescription"; }
            <partial name="_SortableHeader" />
            @{ ViewData["Label"] = "Species"; ViewData["Column"] = "Species"; }
            <partial name="_SortableHeader" />
            @{ ViewData["Label"] = "Customer ref"; ViewData["Column"] = "OtherSubmittedBy"; }
            <partial name="_SortableHeader" />
            @{ ViewData["Label"] = "Completed date"; ViewData["Column"] = "CompletedDate"; }
            <partial name="_SortableHeader" />
            <th scope="col" class="govuk-table__header">Actions</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var b in Model.PagedEntries)
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@b.ID</td>
                <td class="govuk-table__cell">@b.ProjectDescription</td>
                <td class="govuk-table__cell">@b.ContactDescription</td>
                <td class="govuk-table__cell">@b.Species</td>
                <td class="govuk-table__cell">@b.OtherSubmittedBy</td>
                <td class="govuk-table__cell">@b.CompletedDate?.ToShortDateString()</td>
                <td class="govuk-table__cell">
                    <form method="post">
                        <input type="hidden" name="batchId" value="@b.ID" />
                        <a asp-page="/Archive/ArchiveBlocks"
                           asp-route-batchId="@b.ID" class="govuk-button govuk-button--warning govuk-!-margin-bottom-0" data-module="govuk-button">Archive blocks</a>
                        <a asp-page="/Archive/ArchiveTissues"
                           asp-route-batchId="@b.ID" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button">Archive tissues</a>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Batches.Any())
        {
            <tr class="govuk-table__row"><td colspan="7" class="govuk-table__cell">No batches available for archiving.</td></tr>
        }
    </tbody>
</table>
<partial name="_Pagination" />
