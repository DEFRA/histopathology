@page
@model Histo.Web.Pages.Batches.BatchesForArchivingModel
@{
    ViewData["Title"] = "Batches for Archiving";
    ViewData["PageTitle"] = "Batches for Archiving";
}

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Batch ID</th>
            <th>Customer Ref</th>
            <th>Completed Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var b in Model.Batches)
        {
            <tr>
                <td>@b.ID</td>
                <td>@b.CustomerRef</td>
                <td>@b.CompletedDate?.ToShortDateString()</td>
                <td>
                    <a asp-page="/Archive/ArchiveBlocks"
                       asp-route-batchId="@b.ID" class="btn btn-sm btn-warning">Archive Blocks</a>
                    <a asp-page="/Archive/ArchiveTissues"
                       asp-route-batchId="@b.ID" class="btn btn-sm btn-secondary ms-1">Archive Tissues</a>
                </td>
            </tr>
        }
        @if (!Model.Batches.Any())
        {
            <tr><td colspan="4" class="text-center">No batches available for archiving.</td></tr>
        }
    </tbody>
</table>
