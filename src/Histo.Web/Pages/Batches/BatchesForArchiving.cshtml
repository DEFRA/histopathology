@page
@model Histo.Web.Pages.Batches.BatchesForArchivingModel
@{
    ViewData["Title"] = "Batches for archiving";
    ViewData["PageTitle"] = "Batches for archiving";
}

@section BeforeHeading {
    <a asp-page="/Index" class="govuk-back-link">Back</a>
}

<partial name="_QuickGoForm" model="Model" />

<table class="govuk-table">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <partial name="_BatchIdentityHeaders" model="false" />
            @{ ViewData["Label"] = "Submitted Date"; ViewData["Column"] = "CompletedDate"; }
            <partial name="_SortableHeader" />
            <th scope="col" class="govuk-table__header">Actions</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var b in Model.GetPagedEntries())
        {
            <tr class="govuk-table__row">
                <partial name="_BatchIdentityCells" model="b" />
                <td class="govuk-table__cell">@b.CompletedDate?.ToShortDateString()</td>
                <td class="govuk-table__cell">
                    <form method="post">
                        <input type="hidden" name="batchId" value="@b.ID" />
                        <div class="govuk-button-group govuk-!-margin-bottom-0">
                            <a asp-page="/Archive/ArchiveBlocks"
                               asp-route-batchId="@b.ID" class="govuk-button govuk-button--warning app-button-uniform" data-module="govuk-button">Archive blocks</a>
                            <a asp-page="/Archive/ArchiveTissues"
                               asp-route-batchId="@b.ID" class="govuk-button govuk-button--secondary app-button-uniform" data-module="govuk-button">Archive tissues</a>
                        </div>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Batches.Any())
        {
            <tr class="govuk-table__row"><td colspan="6" class="govuk-table__cell">No batches available for archiving.</td></tr>
        }
    </tbody>
</table>
<partial name="_Pagination" />
