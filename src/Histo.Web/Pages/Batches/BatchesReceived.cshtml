@page
@model BatchesReceivedModel
@{
    ViewData["Title"] = "Submissions received";
    ViewData["PageTitle"] = "Submissions received";
}

@section BeforeHeading {
    <a asp-page="/Index" class="govuk-back-link">Back</a>
}

<partial name="_QuickGoForm" model="Model" />

@if (!Model.Batches.Any())
{
    <p class="govuk-body">No received batches.</p>
}
else
{
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <partial name="_BatchIdentityHeaders" model="true" />
                @{ ViewData["Label"] = "Submitted date"; ViewData["Column"] = "BatchDate"; }
                <partial name="_SortableHeader" />
                @{ ViewData["Label"] = "All tissues assigned"; ViewData["Column"] = "AllTissuesAssigned"; }
                <partial name="_SortableHeader" />
                <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Action</span></th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var b in Model.GetPagedEntries())
            {
                <tr class="govuk-table__row">
                    <partial name="_BatchIdentityCells" model="b" />
                    <td class="govuk-table__cell">@b.BatchDate?.ToShortDateString()</td>
                    <td class="govuk-table__cell">
                        @if (b.AllTissuesAssigned)
                        {
                            <strong class="govuk-tag govuk-tag--green">Yes</strong>
                        }
                        else
                        {
                            <strong class="govuk-tag govuk-tag--yellow">No</strong>
                        }
                    </td>
                    <td class="govuk-table__cell">
                        <form method="post" asp-page="/Batches/BatchesReceived">
                            <input type="hidden" name="batchId" value="@b.ID" />
                            <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" asp-page-handler="Select">View<span class="govuk-visually-hidden"> submission @b.ID</span></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Pagination" />
}
