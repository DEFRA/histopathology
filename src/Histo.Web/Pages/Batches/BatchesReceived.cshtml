@page
@model BatchesReceivedModel
@{
    ViewData["Title"] = "Batches received";
    ViewData["PageTitle"] = "Batches received";
}

@section BeforeHeading {
    <a asp-page="/Index" class="govuk-back-link">Back</a>
}

<div class="govuk-form-group">
    <form method="post" asp-page-handler="Go">
        <label class="govuk-label govuk-!-display-inline" asp-for="QuickGoId">Go directly to submission number</label>
        <input class="govuk-input govuk-input--width-10 govuk-!-display-inline govuk-!-margin-left-2" type="number" asp-for="QuickGoId" min="1" />
        <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0 govuk-!-margin-left-2">Go</button>
    </form>
</div>

@if (!Model.Batches.Any())
{
    <p class="govuk-body">No received batches.</p>
}
else
{
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                @{ ViewData["Label"] = "Batch No"; ViewData["Column"] = "ID"; }
                <partial name="_SortableHeader" />
                @{ ViewData["Label"] = "Project"; ViewData["Column"] = "ProjectDescription"; }
                <partial name="_SortableHeader" />
                @{ ViewData["Label"] = "Pathologist"; ViewData["Column"] = "ContactDescription"; }
                <partial name="_SortableHeader" />
                @{ ViewData["Label"] = "Species"; ViewData["Column"] = "Species"; }
                <partial name="_SortableHeader" />
                @{ ViewData["Label"] = "Batch date"; ViewData["Column"] = "BatchDate"; }
                <partial name="_SortableHeader" />
                @{ ViewData["Label"] = "Received date"; ViewData["Column"] = "ReceivedDate"; }
                <partial name="_SortableHeader" />
                @{ ViewData["Label"] = "Customer ref"; ViewData["Column"] = "OtherSubmittedBy"; }
                <partial name="_SortableHeader" />
                @{ ViewData["Label"] = "All tissues assigned"; ViewData["Column"] = "AllTissuesAssigned"; }
                <partial name="_SortableHeader" />
                <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Action</span></th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var b in Model.PagedEntries)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@b.ID</td>
                    <td class="govuk-table__cell">@b.ProjectDescription</td>
                    <td class="govuk-table__cell">@b.ContactDescription</td>
                    <td class="govuk-table__cell">@b.Species</td>
                    <td class="govuk-table__cell">@b.BatchDate?.ToShortDateString()</td>
                    <td class="govuk-table__cell">@b.ReceivedDate?.ToShortDateString()</td>
                    <td class="govuk-table__cell">@b.OtherSubmittedBy</td>
                    <td class="govuk-table__cell">
                        @if (b.AllTissuesAssigned)
                        {
                            <strong class="govuk-tag govuk-tag--green">Yes</strong>
                        }
                        else
                        {
                            <strong class="govuk-tag govuk-tag--yellow">No</strong>
                        }
                    </td>
                    <td class="govuk-table__cell">
                        <form method="post">
                            <input type="hidden" name="batchId" value="@b.ID" />
                            <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" asp-page-handler="Select">View</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Pagination" />
}
