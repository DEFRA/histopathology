@page
@model Histo.Web.Pages.Batches.BatchDetailsModel
@{
    ViewData["Title"] = "Batch details";
    ViewData["PageTitle"] = "Batch details";
}

@section BeforeHeading {
    <a asp-page="/Batches/BatchesForEditing" class="govuk-back-link">Back</a>
}

@if (Model.Batch is null)
{
    <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
            <span class="govuk-visually-hidden">Warning</span>
            Batch not found.
        </strong>
    </div>
}
else
{
    <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Batch ID</dt>
            <dd class="govuk-summary-list__value">@Model.Batch.ID</dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Customer ref</dt>
            <dd class="govuk-summary-list__value">@Model.Batch.CustomerRef</dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Status</dt>
            <dd class="govuk-summary-list__value">@Model.Batch.Status</dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Received date</dt>
            <dd class="govuk-summary-list__value">@Model.Batch.ReceivedDate?.ToShortDateString()</dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Completed date</dt>
            <dd class="govuk-summary-list__value">@Model.Batch.CompletedDate?.ToShortDateString()</dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Comments</dt>
            <dd class="govuk-summary-list__value">@Model.Batch.Comments</dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Submission category</dt>
            <dd class="govuk-summary-list__value">@Histo.Submissions.Models.BatchTypeConstants.DisplayName(Model.Batch.BatchType)</dd>
        </div>
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Pre-cassetted</dt>
            <dd class="govuk-summary-list__value">@(Model.Batch.IsPreCassetted ? "Yes" : "No")</dd>
        </div>
    </dl>
    <a asp-page="/Batches/EditBatch" class="govuk-button" data-module="govuk-button">Edit batch</a>
    <a asp-page="/Submissions/ViewSamples" class="govuk-button govuk-button--secondary" data-module="govuk-button">View samples</a>
    <a asp-page="/Batches/CopyBatch" asp-route-sourceBatchId="@Model.Batch.ID" class="govuk-button govuk-button--secondary" data-module="govuk-button">Copy batch</a>
    <a asp-page="/QC/QualityData" class="govuk-button govuk-button--secondary" data-module="govuk-button">Quality data</a>
    <a asp-page="/QC/QCNotes" class="govuk-button govuk-button--secondary" data-module="govuk-button">QC notes</a>
    <a asp-page="/Reports/HistologyReport" class="govuk-button govuk-button--secondary" data-module="govuk-button">Print submission form</a>
    <a asp-page="/Reports/SubmissionNotes" class="govuk-button govuk-button--secondary" data-module="govuk-button">Print submission notes</a>
    <a asp-page="/Index" class="govuk-button govuk-button--secondary" data-module="govuk-button">Home</a>
}
