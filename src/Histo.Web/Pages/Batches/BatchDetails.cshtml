@page
@model Histo.Web.Pages.Batches.BatchDetailsModel
@{
    ViewData["Title"] = "Batch Details";
    ViewData["PageTitle"] = "Batch Details";
}

@if (Model.Batch is null)
{
    <p class="alert alert-warning">Batch not found.</p>
}
else
{
    <dl class="row">
        <dt class="col-sm-3">Batch ID</dt>         <dd class="col-sm-9">@Model.Batch.ID</dd>
        <dt class="col-sm-3">Customer Ref</dt>     <dd class="col-sm-9">@Model.Batch.CustomerRef</dd>
        <dt class="col-sm-3">Status</dt>           <dd class="col-sm-9">@Model.Batch.Status</dd>
        <dt class="col-sm-3">Received Date</dt>    <dd class="col-sm-9">@Model.Batch.ReceivedDate?.ToShortDateString()</dd>
        <dt class="col-sm-3">Completed Date</dt>   <dd class="col-sm-9">@Model.Batch.CompletedDate?.ToShortDateString()</dd>
        <dt class="col-sm-3">Comments</dt>         <dd class="col-sm-9">@Model.Batch.Comments</dd>
        <dt class="col-sm-3">Pre-Cassetted</dt>    <dd class="col-sm-9">@(Model.Batch.IsPreCassetted ? "Yes" : "No")</dd>
    </dl>
    <a asp-page="/Batches/EditBatch" class="btn btn-primary">Edit Batch</a>
    <a asp-page="/Submissions/ViewSamples" class="btn btn-secondary ms-2">View Samples</a>
    <a asp-page="/Index" class="btn btn-outline-secondary ms-2">Home</a>
}
