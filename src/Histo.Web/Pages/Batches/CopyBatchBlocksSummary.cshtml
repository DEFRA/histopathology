@page "{sourceBatchId:int?}"
@model Histo.Web.Pages.Batches.CopyBatchBlocksSummaryModel
@{
    ViewData["Title"] = "Submission summary";
    ViewData["PageTitle"] = "Submission summary";
}

@section BeforeHeading {
    <a asp-page="/Batches/CopyBatch" asp-route-sourceBatchId="@Model.SourceBatchId" class="govuk-back-link">Back</a>
}

@* Read-only pre-copy preview — replaces legacy's CopyBatchBlocksSummary.aspx (cassetted scenario
   only). Reached from CopyBatch.cshtml's "Summary" button; shows the source submission's current
   blocks/tissues/tests, not the in-progress copy plan. *@

@if (Model.SourceBatch is not null)
{
    <p class="govuk-body">
        The following table displays all samples, blocks, tissues and tests for the current submission.
    </p>

    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Sender ref</th>
                <th scope="col" class="govuk-table__header">Block ref</th>
                <th scope="col" class="govuk-table__header">Tissue details</th>
                <th scope="col" class="govuk-table__header">Archive</th>
                <th scope="col" class="govuk-table__header">EO</th>
                <th scope="col" class="govuk-table__header">H&amp;E</th>
                <th scope="col" class="govuk-table__header">H&amp;E (BSE)</th>
                <th scope="col" class="govuk-table__header">Special stain</th>
                <th scope="col" class="govuk-table__header">IHC Prp</th>
                <th scope="col" class="govuk-table__header">IHC Other</th>
                <th scope="col" class="govuk-table__header">Additional request</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var b in Model.Blocks)
            {
                var blockTissues = Model.TissuesByBlockId.TryGetValue(b.ID, out var bt) ? bt : (IReadOnlyList<Histo.Submissions.Models.Tissue>)[];
                var histCodes = Model.HistologyCodesByBlockId.GetValueOrDefault(b.ID, []);
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@Model.SenderRefsByAnimalId.GetValueOrDefault(b.AnimalID, "—")</td>
                    <td class="govuk-table__cell">@b.BlockRef</td>
                    <td class="govuk-table__cell">
                        @if (blockTissues.Any())
                        {
                            <details class="govuk-details govuk-!-margin-bottom-0">
                                <summary class="govuk-details__summary">
                                    <span class="govuk-details__summary-text">@blockTissues.Count tissue(s)</span>
                                </summary>
                                <div class="govuk-details__text">
                                    <ul class="govuk-list">
                                        @foreach (var t in blockTissues)
                                        {
                                            <li>@t.NoPieces x @Model.TissueName(t.TissueCode)</li>
                                        }
                                    </ul>
                                </div>
                            </details>
                        }
                    </td>
                    <td class="govuk-table__cell"><input type="checkbox" class="govuk-checkboxes__input" aria-label="Archive" disabled checked="@histCodes.Contains(Histo.Submissions.Models.HistologyCode.Archive)" /></td>
                    <td class="govuk-table__cell"><input type="checkbox" class="govuk-checkboxes__input" aria-label="EO" disabled checked="@histCodes.Contains(Histo.Submissions.Models.HistologyCode.EO)" /></td>
                    <td class="govuk-table__cell"><input type="checkbox" class="govuk-checkboxes__input" aria-label="H&amp;E" disabled checked="@histCodes.Contains(Histo.Submissions.Models.HistologyCode.HAndE)" /></td>
                    <td class="govuk-table__cell"><input type="checkbox" class="govuk-checkboxes__input" aria-label="H&amp;E (BSE)" disabled checked="@histCodes.Contains(Histo.Submissions.Models.HistologyCode.HeBse)" /></td>
                    <td class="govuk-table__cell"><input type="checkbox" class="govuk-checkboxes__input" aria-label="Special stain" disabled checked="@histCodes.Contains(Histo.Submissions.Models.HistologyCode.SpecialStain)" /></td>
                    <td class="govuk-table__cell"><input type="checkbox" class="govuk-checkboxes__input" aria-label="IHC Prp" disabled checked="@histCodes.Contains(Histo.Submissions.Models.HistologyCode.IhcPrp)" /></td>
                    <td class="govuk-table__cell"><input type="checkbox" class="govuk-checkboxes__input" aria-label="IHC Other" disabled checked="@histCodes.Contains(Histo.Submissions.Models.HistologyCode.IhcOther)" /></td>
                    <td class="govuk-table__cell"><input type="checkbox" class="govuk-checkboxes__input" aria-label="Additional request" disabled checked="@b.RepeatBlock" /></td>
                </tr>
            }
            @if (!Model.Blocks.Any())
            {
                <tr class="govuk-table__row"><td colspan="11" class="govuk-table__cell">No blocks found for this submission.</td></tr>
            }
        </tbody>
    </table>
}
