@page
@model BatchesForEditingModel
@{
    ViewData["Title"] = "Batches for editing";
    ViewData["PageTitle"] = "Batches for editing";
}

@section BeforeHeading {
    <a asp-page="/Index" class="govuk-back-link">Back</a>
}

@if (!Model.Batches.Any())
{
    <p class="govuk-body">No batches currently in progress.</p>
}
else
{
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Batch No</th>
                <th scope="col" class="govuk-table__header">Customer ref</th>
                <th scope="col" class="govuk-table__header">Received date</th>
                <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Action</span></th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var b in Model.Batches)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@b.ID</td>
                    <td class="govuk-table__cell">@b.CustomerRef</td>
                    <td class="govuk-table__cell">@b.ReceivedDate?.ToShortDateString()</td>
                    <td class="govuk-table__cell">
                        <form method="post">
                            <input type="hidden" name="batchId" value="@b.ID" />
                            <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" asp-page-handler="Select">Edit</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
