@page
@model BatchesForEditingModel
@{
    ViewData["Title"] = "Submissions available for editing";
    ViewData["PageTitle"] = "Submissions available for editing";
}

@section BeforeHeading {
    <a asp-page="/Index" class="govuk-back-link">Back</a>
}

<partial name="_QuickGoForm" model="Model" />

@if (!Model.Batches.Any())
{
    <p class="govuk-body">No batches found.</p>
}
else
{
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <partial name="_BatchIdentityHeaders" model="false" />
                @{ ViewData["Label"] = "Submitted Date"; ViewData["Column"] = "BatchDate"; }
                <partial name="_SortableHeader" />
                @{ ViewData["Label"] = "Status"; ViewData["Column"] = "Status"; }
                <partial name="_SortableHeader" />
                <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Action</span></th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var b in Model.GetPagedEntries())
            {
                <tr class="govuk-table__row">
                    <partial name="_BatchIdentityCells" model="b" />
                    <td class="govuk-table__cell">@b.BatchDate?.ToShortDateString()</td>
                    <td class="govuk-table__cell">
                        <partial name="_StatusTag" model='(Histo.Core.Domain.BatchStatus.TagClassForText(b.Status), Histo.Core.Domain.BatchStatus.NormalizeDisplayText(b.Status))' />
                    </td>
                    <td class="govuk-table__cell">
                        <form method="post" asp-antiforgery="true">
                            <input type="hidden" name="batchId" value="@b.ID" />
                            <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" asp-page-handler="Select">Select<span class="govuk-visually-hidden"> submission @b.ID</span></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Pagination" />
}
