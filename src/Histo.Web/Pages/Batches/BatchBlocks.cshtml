@page
@model Histo.Web.Pages.Batches.BatchBlocksModel
@using Histo.Web.Pages.Shared
@{
    ViewData["Title"] = "Blocks";
    ViewData["PageTitle"] = "Blocks";
}

@section BeforeHeading {
    <a href="@Model.BackLinkPage" class="govuk-back-link">Back</a>
}

@if (TempData["CopyBlocksStatusMessage"] is string statusMessage && !string.IsNullOrEmpty(statusMessage))
{
    <div class="govuk-notification-banner govuk-notification-banner--success" role="alert" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
            <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">Success</h2>
        </div>
        <div class="govuk-notification-banner__content">
            <p class="govuk-notification-banner__heading">@statusMessage</p>
        </div>
    </div>
}

@* Batch-wide overview — replaces legacy's BatchBlocks.aspx. Reached only from BatchDetails'
   "Assign blocks" button; each row's Select checkbox drives the Edit sample/Delete sample/
   Copy selected blocks actions below the grid, matching legacy's single-select grid + action
   button row (Add Sample/Edit Sample/Delete Sample/Copy From Prev. Submission/Cancel/Done). *@

@* Batch header summary — legacy's shared Batch.ascx control (two-column layout: Entered
   by/area, Submitted by/area, Project/contract code, Pathologist, Submission date, Species). *@
@if (Model.Batch is not null)
{
    <div class="govuk-grid-row govuk-!-margin-bottom-6">
        <div class="govuk-grid-column-one-half">
            <dl class="govuk-summary-list">
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">Entered by</dt>
                    <dd class="govuk-summary-list__value">@(Model.EnteredByName ?? "—")</dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">Submitted by</dt>
                    <dd class="govuk-summary-list__value">@(Model.SubmittedByName ?? "—")</dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">Project or Contract code</dt>
                    <dd class="govuk-summary-list__value">@(Model.ProjectName ?? "—")</dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">Pathologist</dt>
                    <dd class="govuk-summary-list__value">@(Model.PathologistName ?? "—")</dd>
                </div>
            </dl>
        </div>
        <div class="govuk-grid-column-one-half">
            <dl class="govuk-summary-list">
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">Entered area</dt>
                    <dd class="govuk-summary-list__value">@(Model.EnteredAreaName ?? "—")</dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">Submitted area</dt>
                    <dd class="govuk-summary-list__value">@(Model.SubmittedAreaName ?? "—")</dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">Submission date</dt>
                    <dd class="govuk-summary-list__value">@(Model.Batch.BatchDate?.ToShortDateString() ?? "—")</dd>
                </div>
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">Species</dt>
                    <dd class="govuk-summary-list__value">@(Model.SpeciesName ?? "—")</dd>
                </div>
            </dl>
        </div>
    </div>
}

@if (Model.ErrorMessage is not null)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list"><li>@Model.ErrorMessage</li></ul>
            </div>
        </div>
    </div>
}

@if (Model.ConfirmDeleteAnimalId is int confirmAnimalId and > 0)
{
    <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
            <span class="govuk-visually-hidden">Warning</span>
            Are you sure you want to delete sample @(Model.SenderRefsByAnimalId.GetValueOrDefault(confirmAnimalId, "this sample"))? This will remove all of its blocks.
        </strong>
    </div>
    <form method="post" asp-page-handler="DeleteSample" class="govuk-!-display-inline">
        <input type="hidden" name="animalId" value="@confirmAnimalId" />
        <input type="hidden" asp-for="BatchId" />
        <button type="submit" class="govuk-button govuk-button--warning" data-module="govuk-button">Yes, delete sample</button>
        <a asp-page="/Batches/BatchBlocks" asp-route-BatchId="@Model.BatchId" class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</a>
    </form>
}

<form method="post" asp-page="/Batches/BatchBlocks">
    <input type="hidden" asp-for="BatchId" />
    <p class="govuk-body">
        The following table displays all samples, blocks, tissues and tests for the current submission.
        A green star next to the sender ref indicates that not all tissues for that sample have been
        assigned to blocks.
    </p>
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Select</th>
                <th scope="col" class="govuk-table__header">Sender ref</th>
                <th scope="col" class="govuk-table__header">Histology ref</th>
                <th scope="col" class="govuk-table__header">Block ref</th>
                <th scope="col" class="govuk-table__header">Tissue details</th>
                <th scope="col" class="govuk-table__header">Archive</th>
                <th scope="col" class="govuk-table__header">EO</th>
                <th scope="col" class="govuk-table__header">H&amp;E</th>
                @if (Model.IsTse)
                {
                    <th scope="col" class="govuk-table__header">H&amp;E (BSE)</th>
                    <th scope="col" class="govuk-table__header">IHC Prp</th>
                }
                else
                {
                    <th scope="col" class="govuk-table__header">IHC Other</th>
                }
                <th scope="col" class="govuk-table__header">Special stain</th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var b in Model.Blocks)
            {
                var blockTissues = Model.TissuesByBlockId.TryGetValue(b.ID, out var bt) ? bt : (IReadOnlyList<Histo.Submissions.Models.Tissue>)[];
                var histCodes = Model.HistologyCodesByBlockId.GetValueOrDefault(b.ID, []);
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">
                        <div class="govuk-checkboxes govuk-checkboxes--small">
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input" type="checkbox" name="blockIds" value="@b.ID" id="select-block-@b.ID" />
                                <label class="govuk-label govuk-checkboxes__label" for="select-block-@b.ID"><span class="govuk-visually-hidden">Select block @b.BlockRef</span></label>
                            </div>
                        </div>
                    </td>
                    <td class="govuk-table__cell">
                        @Model.SenderRefsByAnimalId.GetValueOrDefault(b.AnimalID, "—")
                        @if (Model.AnimalsWithUnassignedTissues.Contains(b.AnimalID))
                        {
                            <span class="app-unassigned-tissues-marker" aria-hidden="true">*</span>
                            <span class="govuk-visually-hidden">Not all tissues for this sample have been assigned to blocks</span>
                        }
                    </td>
                    <td class="govuk-table__cell">@(Model.HistologyRefsByAnimalId.GetValueOrDefault(b.AnimalID) ?? "—")</td>
                    <td class="govuk-table__cell">@b.BlockRef</td>
                    <partial name="_BlockTissuesCell" model="new BlockTissuesCell(blockTissues, Model.TissueName)" />
                    <partial name="_BlockHistologyCells" model="new BlockHistologyCells(b.ID, histCodes, Model.IsTse)" />
                </tr>
            }
            @if (!Model.Blocks.Any())
            {
                <tr class="govuk-table__row"><td colspan="@(Model.IsTse ? 11 : 10)" class="govuk-table__cell">No blocks found for this batch.</td></tr>
            }
        </tbody>
    </table>

    <div class="govuk-button-group">
        @if (!Model.IsViewMode)
        {
            <a asp-page="/Submissions/AddSubmission" asp-route-BatchId="@Model.BatchId"
               asp-route-ReturnPage="@Url.Page("/Batches/BatchBlocks", new { batchId = Model.BatchId })"
               class="govuk-button" data-module="govuk-button">Add sample</a>
            <button type="submit" formaction="?handler=EditSampleSelect" class="govuk-button govuk-button--secondary" data-module="govuk-button">Edit sample</button>
            <button type="submit" formaction="?handler=DeleteSampleSelect" class="govuk-button govuk-button--warning" data-module="govuk-button">Delete sample</button>
        }
        @* Legacy "Copy From Prev. Submission" — copies samples/blocks from a DIFFERENT, earlier
           submission into this one. Named distinctly from SampleSummary's "Copy sample" (which
           duplicates one sample's own tissue list to a new sample within THIS submission) so the
           two aren't confused regardless of which journey led here. *@
        <a asp-page="/Blocks/CopySamples" asp-route-BatchId="@Model.BatchId" class="govuk-button govuk-button--secondary" data-module="govuk-button">Copy from a previous submission</a>
        @if (!Model.IsViewMode)
        {
            <button type="submit" formaction="?handler=Done" class="govuk-button" data-module="govuk-button">Done</button>
        }
    </div>
</form>
