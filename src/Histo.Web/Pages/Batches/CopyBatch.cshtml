@page "{sourceBatchId:int?}"
@model Histo.Web.Pages.Batches.CopyBatchModel
@{
    ViewData["Title"] = "Copy submission";
    ViewData["PageTitle"] = "Copy submission";
}

@section BeforeHeading {
    <a asp-page="/Batches/BatchDetails" class="govuk-back-link">Back</a>
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    <li>@Model.Error</li>
                </ul>
            </div>
        </div>
    </div>
}

@if (Model.SourceBatch is not null)
{
    <form method="post">
        <input type="hidden" asp-for="SourceBatchId" />
        <input type="hidden" asp-for="IsCassetted" />

        <p class="govuk-body">The following table shows the samples in this submission.
        To change a sender reference, edit the value in the <strong>New sender ref</strong> column before clicking Finish.
        Expand a row to view its tissue details where available.</p>

        <h2 class="govuk-heading-m">Samples to copy</h2>
        <table class="govuk-table">
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">Sender ref</th>
                    <th scope="col" class="govuk-table__header">Tissue details</th>
                    <th scope="col" class="govuk-table__header">New sender ref</th>
                    <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Change</span></th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @for (var i = 0; i < Model.Animals.Count; i++)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">@Model.Animals[i].SenderRef</td>
                        <td class="govuk-table__cell">
                            @if (Model.Animals[i].TissueDetails.Any())
                            {
                                <details class="govuk-details">
                                    <summary class="govuk-details__summary">
                                        <span class="govuk-details__summary-text">@Model.Animals[i].TissueDetails.Count tissue(s)</span>
                                    </summary>
                                    <div class="govuk-details__text">
                                        <ul class="govuk-list">
                                            @foreach (var td in Model.Animals[i].TissueDetails)
                                            {
                                                <li>@td</li>
                                            }
                                        </ul>
                                    </div>
                                </details>
                            }
                        </td>
                        <td class="govuk-table__cell">
                            <input type="hidden" asp-for="Animals[i].AnimalId" />
                            <input type="hidden" asp-for="Animals[i].SubmissionId" />
                            <input type="hidden" asp-for="Animals[i].SenderRef" />
                            <input class="govuk-input" id="Animals_@(i)__NewSenderRef" asp-for="Animals[i].NewSenderRef" />
                        </td>
                        <td class="govuk-table__cell">
                            <button type="submit"
                                    formaction="?handler=Pick"
                                    name="rowIndex" value="@i"
                                    class="govuk-link govuk-!-font-size-19">Change</button>
                        </td>
                    </tr>
                }
                @if (!Model.Animals.Any())
                {
                    <tr class="govuk-table__row"><td colspan="4" class="govuk-table__cell">No samples found for this submission.</td></tr>
                }
            </tbody>
        </table>

        <div class="govuk-button-group">
            <button type="submit" class="govuk-button" data-module="govuk-button">Finish</button>
            <a asp-page="/Batches/BatchDetails" class="govuk-button govuk-button--secondary" data-module="govuk-button">Summary</a>
            <a asp-page="/Submissions/ViewSubmissions" class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</a>
        </div>
    </form>
}
