@page
@model BatchesForDispatchModel
@{
    ViewData["Title"] = "Submissions available for quality data entry";
    ViewData["PageTitle"] = "Submissions available for quality data entry";
}

@section BeforeHeading {
    <a asp-page="/Index" class="govuk-back-link">Back</a>
}

<partial name="_QuickGoForm" model="Model" />

@if (!Model.Batches.Any())
{
    <p class="govuk-body">No batches awaiting quality data entry.</p>
}
else
{
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <partial name="_BatchIdentityHeaders" model="false" />
                @{ ViewData["Label"] = "Submitted Date"; ViewData["Column"] = "BatchDate"; }
                <partial name="_SortableHeader" />
                <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Action</span></th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var b in Model.GetPagedEntries())
            {
                <tr class="govuk-table__row">
                    <partial name="_BatchIdentityCells" model="b" />
                    <td class="govuk-table__cell">@b.BatchDate?.ToShortDateString()</td>
                    <td class="govuk-table__cell">
                        <partial name="_BatchSelectButton" model='(b.ID, "Select", "Select")' />
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Pagination" />
}