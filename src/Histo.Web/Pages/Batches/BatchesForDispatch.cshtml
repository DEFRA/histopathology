@page
@model BatchesForDispatchModel
@{
    ViewData["Title"] = "Submissions available for quality data entry";
    ViewData["PageTitle"] = "Submissions available for quality data entry";
}

@section BeforeHeading {
    <a asp-page="/Index" class="govuk-back-link">Back</a>
}

<div class="govuk-form-group">
    @if (!string.IsNullOrEmpty(Model.GoError))
    {
        <div class="govuk-error-summary" data-module="govuk-error-summary">
            <div role="alert">
                <h2 class="govuk-error-summary__title">There is a problem</h2>
                <div class="govuk-error-summary__body">
                    <ul class="govuk-list govuk-error-summary__list">
                        <li>@Model.GoError</li>
                    </ul>
                </div>
            </div>
        </div>
    }
    <form method="post" asp-page-handler="Go">
        <label class="govuk-label govuk-!-display-inline" asp-for="QuickGoId">Go directly to submission number</label>
        <input class="govuk-input govuk-input--width-10 govuk-!-display-inline govuk-!-margin-left-2" type="number" asp-for="QuickGoId" min="1" />
        <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0 govuk-!-margin-left-2">Go</button>
    </form>
</div>

@if (!Model.Batches.Any())
{
    <p class="govuk-body">No batches awaiting quality data entry.</p>
}
else
{
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Batch No</th>
                <th scope="col" class="govuk-table__header">Project</th>
                <th scope="col" class="govuk-table__header">Pathologist</th>
                <th scope="col" class="govuk-table__header">Species</th>
                <th scope="col" class="govuk-table__header">Batch date</th>
                <th scope="col" class="govuk-table__header">Completed date</th>
                <th scope="col" class="govuk-table__header">Customer ref</th>
                <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Action</span></th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var b in Model.Batches)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@b.ID</td>
                    <td class="govuk-table__cell">@b.ProjectDescription</td>
                    <td class="govuk-table__cell">@b.ContactDescription</td>
                    <td class="govuk-table__cell">@b.Species</td>
                    <td class="govuk-table__cell">@b.BatchDate?.ToShortDateString()</td>
                    <td class="govuk-table__cell">@b.CompletedDate?.ToShortDateString()</td>
                    <td class="govuk-table__cell">@b.CustomerRef</td>
                    <td class="govuk-table__cell">
                        <form method="post">
                            <input type="hidden" name="batchId" value="@b.ID" />
                            <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button" asp-page-handler="Select">Select</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
