@page
@model Histo.Web.Pages.Batches.EditBatchModel
@{
    ViewData["Title"] = "Edit batch";
    ViewData["PageTitle"] = "Edit batch";
}

@section BeforeHeading {
    <a asp-page="/Batches/BatchDetails" class="govuk-back-link">Back</a>
}

@if (!string.IsNullOrEmpty(Model.SaveError))
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    <li>@Model.SaveError</li>
                </ul>
            </div>
        </div>
    </div>
}

<form method="post">
    <div class="govuk-form-group">
        <label class="govuk-label" for="CustomerRef">Customer reference</label>
        <input class="govuk-input" asp-for="CustomerRef" />
    </div>
    <div class="govuk-form-group">
        <label class="govuk-label" for="Comments">Comments</label>
        <textarea class="govuk-textarea" asp-for="Comments" rows="4"></textarea>
    </div>
    <div class="govuk-form-group">
        <div class="govuk-checkboxes" data-module="govuk-checkboxes">
            <div class="govuk-checkboxes__item">
                <input class="govuk-checkboxes__input" asp-for="IsPreCassetted" type="checkbox" />
                <label class="govuk-label govuk-checkboxes__label" for="IsPreCassetted">Pre-cassetted</label>
            </div>
        </div>
    </div>
    <button type="submit" class="govuk-button" data-module="govuk-button">Save</button>
    <a asp-page="/Batches/BatchDetails" class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</a>
</form>
