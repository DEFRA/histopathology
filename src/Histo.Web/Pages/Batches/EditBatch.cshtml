@page
@model Histo.Web.Pages.Batches.EditBatchModel
@{
    ViewData["Title"] = "Edit Batch";
    ViewData["PageTitle"] = "Edit Batch";
}

@if (!string.IsNullOrEmpty(Model.SaveError))
{
    <div class="alert alert-danger">@Model.SaveError</div>
}

<form method="post">
    <div class="mb-3">
        <label class="form-label">Customer Reference</label>
        <input asp-for="CustomerRef" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Comments</label>
        <textarea asp-for="Comments" class="form-control" rows="4"></textarea>
    </div>
    <div class="mb-3 form-check">
        <input asp-for="IsPreCassetted" class="form-check-input" type="checkbox" />
        <label class="form-check-label">Pre-Cassetted</label>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="/Batches/BatchDetails" class="btn btn-secondary ms-2">Cancel</a>
</form>
