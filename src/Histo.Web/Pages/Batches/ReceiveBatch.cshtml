@page
@model Histo.Web.Pages.Batches.ReceiveBatchModel
@{
    ViewData["Title"] = "Receive batch";
    ViewData["PageTitle"] = "Receive batch";
}

@section BeforeHeading {
    <a asp-page="/Batches/BatchesNotReceived" class="govuk-back-link">Back</a>
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    <li>@Model.Error</li>
                </ul>
            </div>
        </div>
    </div>
}

@if (Model.Batch is not null)
{
    <p class="govuk-body">Confirm receipt of batch <strong>@Model.Batch.CustomerRef</strong> (ID: @Model.Batch.ID)?</p>
    <form method="post">
        <button type="submit" class="govuk-button" data-module="govuk-button">Confirm receipt</button>
        <a asp-page="/Batches/BatchesNotReceived" class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</a>
    </form>
}
