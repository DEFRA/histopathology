@page
@model Histo.Web.Pages.Submissions.SubmissionDetailsBlockModel
@{
    ViewData["Title"] = Model.AnimalId is not null ? "Sample blocks" : "Blocks";
    ViewData["PageTitle"] = Model.AnimalId is not null ? "Sample blocks" : "Blocks";
}

@section BeforeHeading {
    <a asp-page="/Submissions/BatchBlockSummary" asp-route-BatchId="@Model.BatchId" class="govuk-back-link">Back</a>
}

@if (Model.AnimalId is null)
{
    @* Batch-wide overview — consolidates the former Blocks/BlockDetails.cshtml. Reached from
       BatchDetails' "Assign blocks" button; each row links into the animal-scoped view below
       to add/edit blocks for that specific sample. *@
    <a asp-page="/Blocks/CopySamples" asp-route-BatchId="@Model.BatchId" class="govuk-button govuk-button--secondary" data-module="govuk-button">Copy samples</a>

    @if (Model.ConfirmDeleteBlockId is int confirmBatchBlockId)
    {
        var confirmBatchBlock = Model.Blocks.FirstOrDefault(b => b.ID == confirmBatchBlockId);
        <div class="govuk-warning-text">
            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
            <strong class="govuk-warning-text__text">
                <span class="govuk-visually-hidden">Warning</span>
                Are you sure you want to delete block @(confirmBatchBlock?.BlockRef ?? "this block")?
            </strong>
        </div>
        <form method="post" asp-page-handler="Delete" class="govuk-!-display-inline">
            <input type="hidden" name="blockId" value="@confirmBatchBlockId" />
            <input type="hidden" asp-for="BatchId" />
            <button type="submit" class="govuk-button govuk-button--warning" data-module="govuk-button">Yes, delete block</button>
            <a asp-page="/Submissions/SubmissionDetailsBlock" asp-route-BatchId="@Model.BatchId" class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</a>
        </form>
    }

    <form method="post" asp-page-handler="Copy">
        <input type="hidden" asp-for="BatchId" />
        <table class="govuk-table">
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">Select</th>
                    <th scope="col" class="govuk-table__header">Sender ref</th>
                    <th scope="col" class="govuk-table__header">Block ref</th>
                    <th scope="col" class="govuk-table__header">Customer ref</th>
                    <th scope="col" class="govuk-table__header">Comment</th>
                    <th scope="col" class="govuk-table__header">Repeat</th>
                    <th scope="col" class="govuk-table__header">Status</th>
                    <th scope="col" class="govuk-table__header">Actions</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var b in Model.Blocks)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input" type="checkbox" name="blockIds" value="@b.ID" />
                                <label class="govuk-label govuk-checkboxes__label"><span class="govuk-visually-hidden">Select block @b.BlockRef</span></label>
                            </div>
                        </td>
                        <td class="govuk-table__cell">@Model.SenderRefsByAnimalId.GetValueOrDefault(b.AnimalID, "—")</td>
                        <td class="govuk-table__cell">@b.BlockRef</td>
                        <td class="govuk-table__cell">@b.CustomerRef</td>
                        <td class="govuk-table__cell">@b.Comment</td>
                        <td class="govuk-table__cell">@(b.RepeatBlock ? "Yes" : "No")</td>
                        <td class="govuk-table__cell">@b.Status</td>
                        <td class="govuk-table__cell">
                            <a asp-page="/Submissions/SubmissionDetailsBlock" asp-route-BatchId="@Model.BatchId" asp-route-AnimalId="@b.AnimalID"
                               class="govuk-button govuk-!-margin-bottom-0" data-module="govuk-button">Manage sample</a>
                            <a asp-page="/Submissions/SubmissionDetailsBlock" asp-route-BatchId="@Model.BatchId" asp-route-ConfirmDeleteBlockId="@b.ID"
                               class="govuk-button govuk-button--warning govuk-!-margin-bottom-0" data-module="govuk-button">Delete</a>
                        </td>
                    </tr>
                }
                @if (!Model.Blocks.Any())
                {
                    <tr class="govuk-table__row"><td colspan="8" class="govuk-table__cell">No blocks found for this batch.</td></tr>
                }
            </tbody>
        </table>
        @if (Model.Blocks.Any())
        {
            <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">Copy selected blocks</button>
        }
    </form>

    <a asp-page="/Submissions/BatchBlockSummary" asp-route-BatchId="@Model.BatchId" class="govuk-button govuk-button--secondary" data-module="govuk-button">Back to samples</a>
}
else if (Model.Animal is null)
{
    <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
            <span class="govuk-visually-hidden">Warning</span>
            Sample not found.
        </strong>
    </div>
}
else
{
    @if (Model.ErrorMessage is not null)
    {
        <div class="govuk-error-summary" data-module="govuk-error-summary">
            <div role="alert">
                <h2 class="govuk-error-summary__title">There is a problem</h2>
                <div class="govuk-error-summary__body">
                    <ul class="govuk-list govuk-error-summary__list"><li>@Model.ErrorMessage</li></ul>
                </div>
            </div>
        </div>
    }

    <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Sender ref</dt>
            <dd class="govuk-summary-list__value">@Model.Animal.SenderRef</dd>
        </div>
    </dl>

    <form method="post" asp-page-handler="SaveDetails">
        <input type="hidden" asp-for="BatchId" />
        <input type="hidden" asp-for="AnimalId" />
        <div class="govuk-form-group">
            <label class="govuk-label" for="PMDate">PM date</label>
            <input class="govuk-input" asp-for="PMDate" />
        </div>
        <div class="govuk-form-group">
            <label class="govuk-label" for="HistologyRef">Histology reference</label>
            @if (Model.IsPreCassetted)
            {
                <div class="govuk-hint">Mandatory for pre-cassetted submissions.</div>
            }
            <input class="govuk-input" asp-for="HistologyRef" />
        </div>
        <button type="submit" class="govuk-button" data-module="govuk-button">Save details</button>
    </form>

    <h2 class="govuk-heading-m">Blocks</h2>

    @* "Check used block refs" — inline lookup pre-filled with this sample's sender ref, replacing
       the separate top-level Search block refs detour. *@
    <details class="govuk-details">
        <summary class="govuk-details__summary">
            <span class="govuk-details__summary-text">Check used block refs for this sample</span>
        </summary>
        <div class="govuk-details__text">
            <a asp-page="/Submissions/SubmissionDetailsBlock" asp-route-BatchId="@Model.BatchId" asp-route-AnimalId="@Model.AnimalId" asp-route-ShowUsedRefs="true"
               class="govuk-button govuk-button--secondary govuk-!-margin-bottom-2" data-module="govuk-button">Check now</a>
            @if (Model.ShowUsedRefs)
            {
                @if (Model.UsedBlockRefResults.Any())
                {
                    <table class="govuk-table">
                        <thead class="govuk-table__head">
                            <tr class="govuk-table__row">
                                <th scope="col" class="govuk-table__header">Used block refs</th>
                                <th scope="col" class="govuk-table__header">Unused block refs</th>
                                <th scope="col" class="govuk-table__header">Pre booked block refs</th>
                            </tr>
                        </thead>
                        <tbody class="govuk-table__body">
                            @foreach (var r in Model.UsedBlockRefResults)
                            {
                                <tr class="govuk-table__row">
                                    <td class="govuk-table__cell">@r.UsedBlockRefs</td>
                                    <td class="govuk-table__cell">@r.UnusedBlockRefs</td>
                                    <td class="govuk-table__cell">@r.PreBookedBlockRefs</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="govuk-body">No block refs found for this sender ref.</p>
                }
            }
        </div>
    </details>

    @* "Add block" — restores the missing add action for this sample's blocks. *@
    <form method="post" asp-page-handler="AddBlock" class="govuk-!-margin-bottom-6">
        <input type="hidden" asp-for="BatchId" />
        <input type="hidden" asp-for="AnimalId" />
        <div class="govuk-form-group">
            <label class="govuk-label" for="NewBlockRef">Block ref</label>
            @if (Model.IsPreCassetted)
            {
                <div class="govuk-hint">Pre-cassetted submission — select one of the pre-booked block references.</div>
                <select class="govuk-select" asp-for="NewBlockRef">
                    <option value="">-- Select --</option>
                    @foreach (var pb in Model.PreBookedBlockRefs)
                    {
                        <option value="@pb.BlockRef">@pb.BlockRef</option>
                    }
                </select>
            }
            else
            {
                <input class="govuk-input" asp-for="NewBlockRef" />
            }
        </div>
        <div class="govuk-form-group">
            <label class="govuk-label" for="NewCustomerRef">Customer reference</label>
            <input class="govuk-input" asp-for="NewCustomerRef" />
        </div>
        @if (!Model.IsPreCassetted)
        {
            <div class="govuk-form-group">
                <label class="govuk-label" for="NewNumberOfBlocks">Number of blocks</label>
                <div class="govuk-hint">Creates this many identical blocks, with auto-incrementing block refs.</div>
                <input class="govuk-input govuk-input--width-3" asp-for="NewNumberOfBlocks" />
            </div>
        }
        <div class="govuk-form-group">
            <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                <div class="govuk-checkboxes__item">
                    <input class="govuk-checkboxes__input" asp-for="NewRepeatBlock" type="checkbox" />
                    <label class="govuk-label govuk-checkboxes__label" for="NewRepeatBlock">Additional request (repeat block)</label>
                </div>
            </div>
        </div>
        <button type="submit" class="govuk-button" data-module="govuk-button">Add block</button>
    </form>

    @* Per-block histology/antibodies/special stain test assignment already exists in the QC
       worklist — linked here rather than duplicated, since this page cannot safely create the
       initial test rows itself without confirmed stored procedure support (see chat summary). *@
    <p class="govuk-body">
        <a asp-page="/QC/QualityData" class="govuk-link">Manage histology, antibody and stain tests for this submission's blocks</a>
    </p>

    @* Inline GOV.UK confirmation panel — replaces the browser confirm() dialog for Delete. *@
    @if (Model.ConfirmDeleteBlockId is int confirmBlockId)
    {
        var confirmBlock = Model.Blocks.FirstOrDefault(b => b.ID == confirmBlockId);
        <div class="govuk-warning-text">
            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
            <strong class="govuk-warning-text__text">
                <span class="govuk-visually-hidden">Warning</span>
                Are you sure you want to delete block @(confirmBlock?.BlockRef ?? "this block")?
            </strong>
        </div>
        <form method="post" asp-page-handler="Delete" class="govuk-!-display-inline">
            <input type="hidden" name="blockId" value="@confirmBlockId" />
            <input type="hidden" asp-for="BatchId" />
            <input type="hidden" asp-for="AnimalId" />
            <button type="submit" class="govuk-button govuk-button--warning" data-module="govuk-button">Yes, delete block</button>
            <a asp-page="/Submissions/SubmissionDetailsBlock" asp-route-BatchId="@Model.BatchId" asp-route-AnimalId="@Model.AnimalId" class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</a>
        </form>
    }

    <form method="post" asp-page-handler="Copy">
        <input type="hidden" asp-for="BatchId" />
        <input type="hidden" asp-for="AnimalId" />
        <table class="govuk-table">
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">Select</th>
                    <th scope="col" class="govuk-table__header">Block ref</th>
                    <th scope="col" class="govuk-table__header">Customer ref</th>
                    <th scope="col" class="govuk-table__header">Comment</th>
                    <th scope="col" class="govuk-table__header">Repeat</th>
                    <th scope="col" class="govuk-table__header">Status</th>
                    <th scope="col" class="govuk-table__header">Tissues</th>
                    <th scope="col" class="govuk-table__header">Actions</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var b in Model.Blocks)
                {
                    var blockTissues = Model.TissuesByBlockId.TryGetValue(b.ID, out var bt) ? bt : (IReadOnlyList<Histo.Submissions.Models.Tissue>)[];
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input" type="checkbox" name="blockIds" value="@b.ID" />
                                <label class="govuk-label govuk-checkboxes__label"><span class="govuk-visually-hidden">Select block @b.BlockRef</span></label>
                            </div>
                        </td>
                        <td class="govuk-table__cell">@b.BlockRef</td>
                        <td class="govuk-table__cell">@b.CustomerRef</td>
                        <td class="govuk-table__cell">@b.Comment</td>
                        <td class="govuk-table__cell">@(b.RepeatBlock ? "Yes" : "No")</td>
                        <td class="govuk-table__cell">@b.Status</td>
                        <td class="govuk-table__cell">
                            <details class="govuk-details govuk-!-margin-bottom-0">
                                <summary class="govuk-details__summary">
                                    <span class="govuk-details__summary-text">@blockTissues.Count tissue(s)</span>
                                </summary>
                                <div class="govuk-details__text">
                                    <ul class="govuk-list">
                                        @foreach (var t in blockTissues)
                                        {
                                            <li>
                                                @t.NoPieces x @t.TissueCode @(string.IsNullOrWhiteSpace(t.Comment) ? "" : $"({t.Comment})")
                                                <button type="submit" asp-page-handler="DeleteTissue" name="tissueId" value="@t.ID"
                                                        class="govuk-button govuk-button--warning govuk-!-margin-bottom-0" formmethod="post">Delete</button>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </details>
                        </td>
                        <td class="govuk-table__cell">
                            @* "Delete" — links to the inline confirmation panel above instead of a browser confirm() dialog. *@
                            <a asp-page="/Submissions/SubmissionDetailsBlock" asp-route-BatchId="@Model.BatchId" asp-route-AnimalId="@Model.AnimalId" asp-route-ConfirmDeleteBlockId="@b.ID"
                               class="govuk-button govuk-button--warning govuk-!-margin-bottom-0">Delete</a>
                        </td>
                    </tr>
                }
                @if (!Model.Blocks.Any())
                {
                    <tr class="govuk-table__row"><td colspan="8" class="govuk-table__cell">No blocks found for this sample.</td></tr>
                }
            </tbody>
        </table>
        @if (Model.Blocks.Any())
        {
            <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">Copy selected blocks</button>
        }
    </form>

    @* "Add tissue" — restores per-block tissue assignment missing from the migrated page. *@
    @if (Model.Blocks.Any())
    {
        <h2 class="govuk-heading-m">Add tissue to a block</h2>
        <form method="post" asp-page-handler="AddTissue">
            <input type="hidden" asp-for="BatchId" />
            <input type="hidden" asp-for="AnimalId" />
            <div class="govuk-form-group">
                <label class="govuk-label" for="NewTissueBlockId">Block</label>
                <select class="govuk-select" asp-for="NewTissueBlockId">
                    @foreach (var b in Model.Blocks)
                    {
                        <option value="@b.ID">@b.BlockRef</option>
                    }
                </select>
            </div>
            <div class="govuk-form-group">
                <label class="govuk-label" for="NewTissueCode">Tissue type</label>
                <select class="govuk-select" asp-for="NewTissueCode">
                    <option value="">-- Select --</option>
                    @foreach (var t in Model.TissueOptions)
                    {
                        <option value="@t.Code">@t.Name</option>
                    }
                </select>
            </div>
            <div class="govuk-form-group">
                <label class="govuk-label" for="NewTissueNoPieces">Number of pieces</label>
                <input class="govuk-input govuk-input--width-3" asp-for="NewTissueNoPieces" />
            </div>
            <div class="govuk-form-group">
                <label class="govuk-label" for="NewTissueComment">Comment</label>
                <input class="govuk-input" asp-for="NewTissueComment" />
            </div>
            <button type="submit" class="govuk-button" data-module="govuk-button">Add tissue</button>
        </form>
    }

    <a asp-page="/Submissions/BatchBlockSummary" asp-route-BatchId="@Model.BatchId" class="govuk-button govuk-button--secondary" data-module="govuk-button">Back to samples</a>
}
