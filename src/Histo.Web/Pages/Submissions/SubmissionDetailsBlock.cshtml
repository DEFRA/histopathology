@page
@model Histo.Web.Pages.Submissions.SubmissionDetailsBlockModel
@{
    ViewData["Title"] = Model.AnimalId is not null ? "Sample blocks" : "Blocks";
    ViewData["PageTitle"] = Model.AnimalId is not null ? "Sample blocks" : "Blocks";
}

@section BeforeHeading {
    <a asp-page="/Submissions/SampleSummary" asp-route-BatchId="@Model.BatchId" class="govuk-back-link">Back</a>
}

@if (Model.AnimalId is null)
{
    @* Batch-wide overview — consolidates the former Blocks/BlockDetails.cshtml. Reached from
       BatchDetails' "Assign blocks" button; each row links into the animal-scoped view below
       to add/edit blocks for that specific sample. *@
    @if (!Model.IsViewMode)
    {
        <a asp-page="/Blocks/CopySamples" asp-route-BatchId="@Model.BatchId" class="govuk-button govuk-button--secondary" data-module="govuk-button">Copy samples</a>
    }

    @if (Model.ConfirmDeleteBlockIds.FirstOrDefault() is int confirmBatchBlockId and > 0)
    {
        var confirmBatchBlock = Model.Blocks.FirstOrDefault(b => b.ID == confirmBatchBlockId);
        <div class="govuk-warning-text">
            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
            <strong class="govuk-warning-text__text">
                <span class="govuk-visually-hidden">Warning</span>
                Are you sure you want to delete block @(confirmBatchBlock?.BlockRef ?? "this block")?
            </strong>
        </div>
        <form method="post" asp-page-handler="Delete" class="govuk-!-display-inline">
            <input type="hidden" name="blockIds" value="@confirmBatchBlockId" />
            <input type="hidden" asp-for="BatchId" />
            <button type="submit" class="govuk-button govuk-button--warning" data-module="govuk-button">Yes, delete block</button>
            <a asp-page="/Submissions/SubmissionDetailsBlock" asp-route-BatchId="@Model.BatchId" class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</a>
        </form>
    }

    <form method="post" asp-page-handler="Copy">
        <input type="hidden" asp-for="BatchId" />
        <table class="govuk-table">
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">Select</th>
                    <th scope="col" class="govuk-table__header">Sender ref</th>
                    <th scope="col" class="govuk-table__header">Block ref</th>
                    <th scope="col" class="govuk-table__header">Customer ref</th>
                    <th scope="col" class="govuk-table__header">Comment</th>
                    <th scope="col" class="govuk-table__header">Repeat</th>
                    <th scope="col" class="govuk-table__header">Status</th>
                    <th scope="col" class="govuk-table__header">Actions</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var b in Model.Blocks)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input" type="checkbox" name="blockIds" value="@b.ID" />
                                <label class="govuk-label govuk-checkboxes__label"><span class="govuk-visually-hidden">Select block @b.BlockRef</span></label>
                            </div>
                        </td>
                        <td class="govuk-table__cell">@Model.SenderRefsByAnimalId.GetValueOrDefault(b.AnimalID, "—")</td>
                        <td class="govuk-table__cell">@b.BlockRef</td>
                        <td class="govuk-table__cell">@b.CustomerRef</td>
                        <td class="govuk-table__cell">@b.Comment</td>
                        <td class="govuk-table__cell">@(b.RepeatBlock ? "Yes" : "No")</td>
                        <td class="govuk-table__cell">@b.Status</td>
                        <td class="govuk-table__cell">
                            <a asp-page="/Submissions/SubmissionDetailsBlock" asp-route-BatchId="@Model.BatchId" asp-route-AnimalId="@b.AnimalID"
                               class="govuk-button govuk-!-margin-bottom-0" data-module="govuk-button">Manage sample</a>
                            @if (!Model.IsViewMode)
                            {
                                <a asp-page="/Submissions/SubmissionDetailsBlock" asp-route-BatchId="@Model.BatchId" asp-route-ConfirmDeleteBlockIds="@b.ID"
                                   class="govuk-button govuk-button--warning govuk-!-margin-bottom-0" data-module="govuk-button">Delete</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Blocks.Any())
                {
                    <tr class="govuk-table__row"><td colspan="8" class="govuk-table__cell">No blocks found for this batch.</td></tr>
                }
            </tbody>
        </table>
        @if (Model.Blocks.Any() && !Model.IsViewMode)
        {
            <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">Copy selected blocks</button>
        }
    </form>

    <a asp-page="/Submissions/SampleSummary" asp-route-BatchId="@Model.BatchId" class="govuk-button govuk-button--secondary" data-module="govuk-button">Back to samples</a>
}
else if (Model.Animal is null)
{
    <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
            <span class="govuk-visually-hidden">Warning</span>
            Sample not found.
        </strong>
    </div>
    <a asp-page="/Submissions/SampleSummary" asp-route-BatchId="@Model.BatchId" class="govuk-button govuk-button--secondary" data-module="govuk-button">Back to samples</a>
}
else
{
    @if (Model.ErrorMessage is not null)
    {
        <div class="govuk-error-summary" data-module="govuk-error-summary">
            <div role="alert">
                <h2 class="govuk-error-summary__title">There is a problem</h2>
                <div class="govuk-error-summary__body">
                    <ul class="govuk-list govuk-error-summary__list"><li>@Model.ErrorMessage</li></ul>
                </div>
            </div>
        </div>
    }

    <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Sender ref</dt>
            <dd class="govuk-summary-list__value">@Model.Animal.SenderRef</dd>
        </div>
    </dl>

    <form method="post" asp-page-handler="SaveDetails">
        <input type="hidden" asp-for="BatchId" />
        <input type="hidden" asp-for="AnimalId" />
        <div class="govuk-form-group">
            <label class="govuk-label" for="PMDate">PM date</label>
            @if (Model.IsViewMode)
            {
                <input class="govuk-input" asp-for="PMDate" readonly disabled />
            }
            else
            {
                <input class="govuk-input" asp-for="PMDate" />
            }
        </div>
        <div class="govuk-form-group">
            <label class="govuk-label" for="HistologyRef">Histology reference</label>
            @if (Model.IsPreCassetted)
            {
                <div class="govuk-hint">Mandatory for pre-cassetted submissions.</div>
            }
            @if (Model.IsViewMode)
            {
                <input class="govuk-input govuk-input--width-20" asp-for="HistologyRef" readonly disabled />
            }
            else
            {
                <input class="govuk-input govuk-input--width-20" asp-for="HistologyRef" />
            }
        </div>
        @if (!Model.IsViewMode)
        {
            <button type="submit" class="govuk-button" data-module="govuk-button">Save details</button>
        }
    </form>

    @* "Or Pick" — assigns the next unused histology ref for a type, replacing legacy's
       AutoPostBack dropdown with an explicit button per WCAG 3.2.2 (On Input). *@
    @if (!Model.IsViewMode)
    {
        <form method="post" asp-page-handler="GetNextHistologyRef" class="govuk-!-margin-bottom-6">
            <input type="hidden" asp-for="BatchId" />
            <input type="hidden" asp-for="AnimalId" />
            <div class="govuk-form-group">
                <label class="govuk-label" for="HistologyRefType">Or pick a histology reference type</label>
                <select class="govuk-select" asp-for="HistologyRefType">
                    <option value="">-- Select --</option>
                    @foreach (var t in Histo.Web.Pages.Submissions.SubmissionDetailsBlockModel.HistologyRefTypeOptions)
                    {
                        <option value="@t.Value">@t.Label</option>
                    }
                </select>
            </div>
            <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">Get next ref</button>
        </form>
    }

    <h2 class="govuk-heading-m">Blocks</h2>

    @* "Block ref search" — inline lookup pre-filled with this sample's sender ref, replacing
       legacy's navigate-away to SearchBlockRefs.aspx. *@
    <details class="govuk-details">
        <summary class="govuk-details__summary">
            <span class="govuk-details__summary-text">Block ref search — check used block refs for this sample</span>
        </summary>
        <div class="govuk-details__text">
            <a asp-page="/Submissions/SubmissionDetailsBlock" asp-route-BatchId="@Model.BatchId" asp-route-AnimalId="@Model.AnimalId" asp-route-ShowUsedRefs="true"
               class="govuk-button govuk-button--secondary govuk-!-margin-bottom-2" data-module="govuk-button">Check now</a>
            @if (Model.ShowUsedRefs)
            {
                @if (Model.UsedBlockRefResults.Any())
                {
                    <table class="govuk-table">
                        <thead class="govuk-table__head">
                            <tr class="govuk-table__row">
                                <th scope="col" class="govuk-table__header">Used block refs</th>
                                <th scope="col" class="govuk-table__header">Unused block refs</th>
                                <th scope="col" class="govuk-table__header">Pre booked block refs</th>
                            </tr>
                        </thead>
                        <tbody class="govuk-table__body">
                            @foreach (var r in Model.UsedBlockRefResults)
                            {
                                <tr class="govuk-table__row">
                                    <td class="govuk-table__cell">@r.UsedBlockRefs</td>
                                    <td class="govuk-table__cell">@r.UnusedBlockRefs</td>
                                    <td class="govuk-table__cell">@r.PreBookedBlockRefs</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="govuk-body">No block refs found for this sender ref.</p>
                }
            }
        </div>
    </details>

    @* Inline GOV.UK confirmation panel — replaces the browser confirm() dialog for Delete. *@
    @if (!Model.IsViewMode && Model.ConfirmDeleteBlockIds.Any())
    {
        <div class="govuk-warning-text">
            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
            <strong class="govuk-warning-text__text">
                <span class="govuk-visually-hidden">Warning</span>
                Are you sure you want to delete @(Model.ConfirmDeleteBlockIds.Count == 1 ? "this block" : $"these {Model.ConfirmDeleteBlockIds.Count} blocks")?
            </strong>
        </div>
        <form method="post" asp-page-handler="Delete" class="govuk-!-display-inline">
            @foreach (var id in Model.ConfirmDeleteBlockIds)
            {
                <input type="hidden" name="blockIds" value="@id" />
            }
            <input type="hidden" asp-for="BatchId" />
            <input type="hidden" asp-for="AnimalId" />
            <button type="submit" class="govuk-button govuk-button--warning" data-module="govuk-button">Yes, delete</button>
            <a asp-page="/Submissions/SubmissionDetailsBlock" asp-route-BatchId="@Model.BatchId" asp-route-AnimalId="@Model.AnimalId" class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</a>
        </form>
    }

    @* Legacy-matching grid: Block Ref, Tissue Details, Archive, EO, H&E, H&E(BSE)/IHC Prp (TSE)
       or IHC Other (NonTSE), Special Stain, Select. Add/Edit block navigate to the dedicated
       Blocks/BlockDetails page, matching legacy's SubmissionDetailsBlock.aspx/BlockDetails.aspx split. *@
    <form method="post" id="blocks-grid-form">
        <input type="hidden" asp-for="BatchId" />
        <input type="hidden" asp-for="AnimalId" />
        <table class="govuk-table">
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">Block ref</th>
                    <th scope="col" class="govuk-table__header">Tissue details</th>
                    <th scope="col" class="govuk-table__header">Archive</th>
                    <th scope="col" class="govuk-table__header">EO</th>
                    <th scope="col" class="govuk-table__header">H&amp;E</th>
                    @if (Model.IsTse)
                    {
                        <th scope="col" class="govuk-table__header">H&amp;E (BSE)</th>
                        <th scope="col" class="govuk-table__header">IHC Prp</th>
                    }
                    else
                    {
                        <th scope="col" class="govuk-table__header">IHC Other</th>
                    }
                    <th scope="col" class="govuk-table__header">Special stain</th>
                    <th scope="col" class="govuk-table__header">Select</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var b in Model.Blocks)
                {
                    var blockTissues = Model.TissuesByBlockId.TryGetValue(b.ID, out var bt) ? bt : (IReadOnlyList<Histo.Submissions.Models.Tissue>)[];
                    var histCodes = Model.HistologyCodesByBlockId.GetValueOrDefault(b.ID, []);
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">@b.BlockRef</td>
                        <td class="govuk-table__cell">
                            @if (blockTissues.Any())
                            {
                                <details class="govuk-details govuk-!-margin-bottom-0">
                                    <summary class="govuk-details__summary">
                                        <span class="govuk-details__summary-text">@blockTissues.Count tissue(s)</span>
                                    </summary>
                                    <div class="govuk-details__text">
                                        <ul class="govuk-list">
                                            @foreach (var t in blockTissues)
                                            {
                                                <li>@t.NoPieces x @Model.TissueName(t.TissueCode) @(string.IsNullOrWhiteSpace(t.Comment) ? "" : $"({t.Comment})")</li>
                                            }
                                        </ul>
                                    </div>
                                </details>
                            }
                            else
                            {
                                <span>None</span>
                            }
                        </td>
                        <td class="govuk-table__cell">
                            <input type="checkbox" class="govuk-checkboxes__input" disabled checked="@histCodes.Contains(Histo.Submissions.Models.HistologyCode.Archive)" aria-label="Archived" />
                        </td>
                        <td class="govuk-table__cell">
                            <input type="checkbox" class="govuk-checkboxes__input" disabled checked="@histCodes.Contains(Histo.Submissions.Models.HistologyCode.EO)" aria-label="EO" />
                        </td>
                        <td class="govuk-table__cell">
                            <input type="checkbox" class="govuk-checkboxes__input" disabled checked="@histCodes.Contains(Histo.Submissions.Models.HistologyCode.HAndE)" aria-label="H&amp;E" />
                        </td>
                        @if (Model.IsTse)
                        {
                            <td class="govuk-table__cell">
                                <input type="checkbox" class="govuk-checkboxes__input" disabled checked="@histCodes.Contains(Histo.Submissions.Models.HistologyCode.HeBse)" aria-label="H&amp;E (BSE)" />
                            </td>
                            <td class="govuk-table__cell">
                                <input type="checkbox" class="govuk-checkboxes__input" disabled checked="@histCodes.Contains(Histo.Submissions.Models.HistologyCode.IhcPrp)" aria-label="IHC Prp" />
                            </td>
                        }
                        else
                        {
                            <td class="govuk-table__cell">
                                <input type="checkbox" class="govuk-checkboxes__input" disabled checked="@histCodes.Contains(Histo.Submissions.Models.HistologyCode.IhcOther)" aria-label="IHC Other" />
                            </td>
                        }
                        <td class="govuk-table__cell">
                            <input type="checkbox" class="govuk-checkboxes__input" disabled checked="@histCodes.Contains(Histo.Submissions.Models.HistologyCode.SpecialStain)" aria-label="Special stain" />
                        </td>
                        <td class="govuk-table__cell">
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input" type="checkbox" name="blockIds" value="@b.ID" form="blocks-grid-form" />
                                <label class="govuk-label govuk-checkboxes__label"><span class="govuk-visually-hidden">Select block @b.BlockRef</span></label>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Blocks.Any())
                {
                    <tr class="govuk-table__row"><td colspan="9" class="govuk-table__cell">No blocks found for this sample.</td></tr>
                }
            </tbody>
        </table>

        <div class="govuk-button-group">
            @if (!Model.IsViewMode)
            {
                <a asp-page="/Blocks/BlockDetails" asp-route-BatchId="@Model.BatchId" asp-route-AnimalId="@Model.AnimalId" class="govuk-button" data-module="govuk-button">Add block</a>
                <button type="submit" formaction="?handler=EditBlockSelect" class="govuk-button govuk-button--secondary" data-module="govuk-button">Edit block</button>
                <button type="submit" formaction="?handler=Delete" class="govuk-button govuk-button--warning" data-module="govuk-button">Delete block</button>
                <button type="submit" formaction="?handler=Copy" class="govuk-button govuk-button--secondary" data-module="govuk-button">Copy to samples</button>
            }
            <a asp-page="/Submissions/SampleSummary" asp-route-BatchId="@Model.BatchId" class="govuk-button govuk-button--secondary" data-module="govuk-button">Back</a>
        </div>
    </form>
}
