@page
@model Histo.Web.Pages.Submissions.SubmissionDetailsBlockModel
@{
    ViewData["Title"] = "Sample blocks";
    ViewData["PageTitle"] = "Sample blocks";
}

@section BeforeHeading {
    <a asp-page="/Submissions/BatchBlockSummary" class="govuk-back-link">Back</a>
}

@if (Model.Animal is null)
{
    <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
            <span class="govuk-visually-hidden">Warning</span>
            Sample not found.
        </strong>
    </div>
}
else
{
    <dl class="govuk-summary-list">
        <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Sender ref</dt>
            <dd class="govuk-summary-list__value">@Model.Animal.SenderRef</dd>
        </div>
    </dl>

    <form method="post" asp-page-handler="SaveDetails">
        <div class="govuk-form-group">
            <label class="govuk-label" for="PMDate">PM date</label>
            <input class="govuk-input" asp-for="PMDate" />
        </div>
        <div class="govuk-form-group">
            <label class="govuk-label" for="HistologyRef">Histology reference</label>
            <input class="govuk-input" asp-for="HistologyRef" />
        </div>
        <button type="submit" class="govuk-button" data-module="govuk-button">Save details</button>
    </form>

    <h2 class="govuk-heading-m">Blocks</h2>

    @* "Check used block refs" — inline lookup pre-filled with this sample's sender ref, replacing
       the separate top-level Search block refs detour. *@
    <details class="govuk-details">
        <summary class="govuk-details__summary">
            <span class="govuk-details__summary-text">Check used block refs for this sample</span>
        </summary>
        <div class="govuk-details__text">
            <a asp-page="/Submissions/SubmissionDetailsBlock" asp-route-ShowUsedRefs="true"
               class="govuk-button govuk-button--secondary govuk-!-margin-bottom-2" data-module="govuk-button">Check now</a>
            @if (Model.ShowUsedRefs)
            {
                @if (Model.UsedBlockRefResults.Any())
                {
                    <table class="govuk-table">
                        <thead class="govuk-table__head">
                            <tr class="govuk-table__row">
                                <th scope="col" class="govuk-table__header">Used block refs</th>
                                <th scope="col" class="govuk-table__header">Unused block refs</th>
                                <th scope="col" class="govuk-table__header">Pre booked block refs</th>
                            </tr>
                        </thead>
                        <tbody class="govuk-table__body">
                            @foreach (var r in Model.UsedBlockRefResults)
                            {
                                <tr class="govuk-table__row">
                                    <td class="govuk-table__cell">@r.UsedBlockRefs</td>
                                    <td class="govuk-table__cell">@r.UnusedBlockRefs</td>
                                    <td class="govuk-table__cell">@r.PreBookedBlockRefs</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="govuk-body">No block refs found for this sender ref.</p>
                }
            }
        </div>
    </details>

    @* "Add block" — restores the missing add action for this sample's blocks. *@
    <form method="post" asp-page-handler="AddBlock" class="govuk-!-margin-bottom-6">
        <div class="govuk-form-group">
            <label class="govuk-label" for="NewBlockRef">Block ref</label>
            <input class="govuk-input" asp-for="NewBlockRef" />
        </div>
        <div class="govuk-form-group">
            <label class="govuk-label" for="NewCustomerRef">Customer reference</label>
            <input class="govuk-input" asp-for="NewCustomerRef" />
        </div>
        <div class="govuk-form-group">
            <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                <div class="govuk-checkboxes__item">
                    <input class="govuk-checkboxes__input" asp-for="NewRepeatBlock" type="checkbox" />
                    <label class="govuk-label govuk-checkboxes__label" for="NewRepeatBlock">Additional request (repeat block)</label>
                </div>
            </div>
        </div>
        <button type="submit" class="govuk-button" data-module="govuk-button">Add block</button>
    </form>

    @* Inline GOV.UK confirmation panel — replaces the browser confirm() dialog for Delete. *@
    @if (Model.ConfirmDeleteBlockId is int confirmBlockId)
    {
        var confirmBlock = Model.Blocks.FirstOrDefault(b => b.ID == confirmBlockId);
        <div class="govuk-warning-text">
            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
            <strong class="govuk-warning-text__text">
                <span class="govuk-visually-hidden">Warning</span>
                Are you sure you want to delete block @(confirmBlock?.BlockRef ?? "this block")?
            </strong>
        </div>
        <form method="post" asp-page-handler="Delete" class="govuk-!-display-inline">
            <input type="hidden" name="blockId" value="@confirmBlockId" />
            <button type="submit" class="govuk-button govuk-button--warning" data-module="govuk-button">Yes, delete block</button>
            <a asp-page="/Submissions/SubmissionDetailsBlock" class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</a>
        </form>
    }

    <form method="post" asp-page-handler="Copy">
        <table class="govuk-table">
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">Select</th>
                    <th scope="col" class="govuk-table__header">Block ref</th>
                    <th scope="col" class="govuk-table__header">Customer ref</th>
                    <th scope="col" class="govuk-table__header">Comment</th>
                    <th scope="col" class="govuk-table__header">Repeat</th>
                    <th scope="col" class="govuk-table__header">Status</th>
                    <th scope="col" class="govuk-table__header">Actions</th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var b in Model.Blocks)
                {
                    <tr class="govuk-table__row">
                        <td class="govuk-table__cell">
                            <div class="govuk-checkboxes__item">
                                <input class="govuk-checkboxes__input" type="checkbox" name="blockIds" value="@b.ID" />
                                <label class="govuk-label govuk-checkboxes__label"><span class="govuk-visually-hidden">Select block @b.BlockRef</span></label>
                            </div>
                        </td>
                        <td class="govuk-table__cell">@b.BlockRef</td>
                        <td class="govuk-table__cell">@b.CustomerRef</td>
                        <td class="govuk-table__cell">@b.Comment</td>
                        <td class="govuk-table__cell">@(b.RepeatBlock ? "Yes" : "No")</td>
                        <td class="govuk-table__cell">@b.Status</td>
                        <td class="govuk-table__cell">
                            @* "Delete" — links to the inline confirmation panel above instead of a browser confirm() dialog. *@
                            <a asp-page="/Submissions/SubmissionDetailsBlock" asp-route-ConfirmDeleteBlockId="@b.ID"
                               class="govuk-button govuk-button--warning govuk-!-margin-bottom-0">Delete</a>
                        </td>
                    </tr>
                }
                @if (!Model.Blocks.Any())
                {
                    <tr class="govuk-table__row"><td colspan="7" class="govuk-table__cell">No blocks found for this sample.</td></tr>
                }
            </tbody>
        </table>
        @if (Model.Blocks.Any())
        {
            <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">Copy selected blocks</button>
        }
    </form>

    <a asp-page="/Submissions/BatchBlockSummary" class="govuk-button govuk-button--secondary" data-module="govuk-button">Back to samples</a>
}
