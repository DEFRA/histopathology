@page
@model Histo.Web.Pages.Submissions.AddSubmissionModel
@{
    ViewData["Title"] = "Add sample";
    ViewData["PageTitle"] = "Add sample";
}

@section BeforeHeading {
    <a asp-page="/Submissions/SampleSummary" asp-route-BatchId="@Model.BatchId" class="govuk-back-link">Back</a>
}

@if (Model.ModelError is not null)
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list"><li>@Model.ModelError</li></ul>
            </div>
        </div>
    </div>
}

<form method="post" asp-antiforgery="true">
    <input type="hidden" asp-for="BatchId" />
    <input type="hidden" asp-for="BatchSubmissionId" />
    <input type="hidden" asp-for="SourceAnimalId" />
    <input type="hidden" id="icc-filter" name="Filter" value="" />
    <div class="govuk-form-group">
        <label class="govuk-label" for="SenderRef">Sender reference</label>
        <input class="govuk-input govuk-input--width-20" asp-for="SenderRef" required />
    </div>
    <p class="govuk-body">
        <a asp-page="/Search/SearchSender" asp-route-returnPage="/Submissions/AddSubmission" asp-route-SenderRef="@Model.SenderRef" class="govuk-link">
            Search for a previously used sender reference
        </a>
    </p>
    <p class="govuk-body">
        @* Contextual lookup, pre-filled with the sender ref entered above — a plain submit
           button with formmethod/formaction so it doesn't need its own nested <form>. *@
        <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button"
                formmethod="get" formaction="@Url.Page("/Search/ViewImportedData")" formnovalidate
                onclick="document.getElementById('icc-filter').value = document.getElementById('SenderRef').value;">
            Check historical data for this sender ref
        </button>
    </p>
    <div class="govuk-button-group">
        <button type="submit" class="govuk-button" data-module="govuk-button">Add sample</button>
        <a asp-page="/Submissions/SampleSummary" asp-route-BatchId="@Model.BatchId" class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</a>
    </div>
</form>
