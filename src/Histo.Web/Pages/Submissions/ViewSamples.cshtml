@page
@model Histo.Web.Pages.Submissions.ViewSamplesModel
@{
    ViewData["Title"] = "View Samples";
    ViewData["PageTitle"] = "View Samples";
}

<a asp-page="/Submissions/AddSubmission" class="btn btn-success mb-3">Add Animal</a>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Sender Ref</th>
            <th>Histology Ref</th>
            <th>On Hold</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model.Animals)
        {
            <tr>
                <td>@a.SenderRef</td>
                <td>@a.HistologyRef</td>
                <td>@(a.OnHold ? "Yes" : "No")</td>
                <td>
                    <form method="post" asp-page-handler="Select">
                        <input type="hidden" name="animalId" value="@a.ID" />
                        <button type="submit" class="btn btn-sm btn-primary">Blocks</button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Animals.Any())
        {
            <tr><td colspan="4" class="text-center">No animals in this batch.</td></tr>
        }
    </tbody>
</table>
