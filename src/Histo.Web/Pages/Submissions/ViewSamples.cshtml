@page
@model Histo.Web.Pages.Submissions.ViewSamplesModel
@{
    ViewData["Title"] = "View Samples";
    ViewData["PageTitle"] = "View Samples";
}

<a asp-page="/Submissions/AddSubmission" class="govuk-button govuk-!-margin-bottom-4" data-module="govuk-button">Add animal</a>

<table class="govuk-table">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Sender ref</th>
            <th scope="col" class="govuk-table__header">Histology ref</th>
            <th scope="col" class="govuk-table__header">On hold</th>
            <th scope="col" class="govuk-table__header">Actions</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var a in Model.Animals)
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@a.SenderRef</td>
                <td class="govuk-table__cell">@a.HistologyRef</td>
                <td class="govuk-table__cell">@(a.OnHold ? "Yes" : "No")</td>
                <td class="govuk-table__cell">
                    <form method="post" asp-page-handler="Select" class="govuk-!-display-inline">
                        <input type="hidden" name="animalId" value="@a.ID" />
                        <button type="submit" class="govuk-button govuk-!-margin-bottom-0">Blocks</button>
                    </form>
                    <form method="post" asp-page-handler="Edit" class="govuk-!-display-inline">
                        <input type="hidden" name="animalId" value="@a.ID" />
                        <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0">Tissues</button>
                    </form>
                    <form method="post" asp-page-handler="Delete" class="govuk-!-display-inline">
                        <input type="hidden" name="animalId" value="@a.ID" />
                        <button type="submit" class="govuk-button govuk-button--warning govuk-!-margin-bottom-0"
                                onclick="return confirm('Delete this sample?')">Delete</button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Animals.Any())
        {
            <tr class="govuk-table__row"><td colspan="4" class="govuk-table__cell">No animals in this batch.</td></tr>
        }
    </tbody>
</table>
