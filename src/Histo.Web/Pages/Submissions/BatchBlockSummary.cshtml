@page
@model Histo.Web.Pages.Submissions.BatchBlockSummaryModel
@{
    ViewData["Title"] = "Sample summary";
    ViewData["PageTitle"] = "Sample summary";
}

@section BeforeHeading {
    <a asp-page="/Batches/BatchDetails" class="govuk-back-link">Back</a>
}

@* "Add sample" — legacy btnAddSubmission, only enabled while the batch is still Submitted/Rejected
   (BatchSummary.aspx.vb / BatchBlockSummary.aspx.vb::EnableDisableButtons). Hidden for Received/InProgress/
   Completed/OnHold batches, where the animal list is locked. *@
@if (Model.CanModifySamples)
{
    <a asp-page="/Submissions/AddSubmission" class="govuk-button govuk-!-margin-bottom-4" data-module="govuk-button">Add sample</a>
}

<table class="govuk-table">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Sender ref</th>
            <th scope="col" class="govuk-table__header">Histology ref</th>
            <th scope="col" class="govuk-table__header">On hold</th>
            <th scope="col" class="govuk-table__header">Actions</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var a in Model.Animals)
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@a.SenderRef</td>
                <td class="govuk-table__cell">@a.HistologyRef</td>
                <td class="govuk-table__cell">@(a.OnHold ? "Yes" : "No")</td>
                <td class="govuk-table__cell">
                    @* "Edit sample" — navigates to block editing for this animal. Not gated by CanModifySamples:
                       legacy BatchBlockSummary.aspx.vb keeps Edit selectable in View mode (unlike BatchSummary.aspx.vb,
                       which force-disables it too), since block assignment/viewing continues after receipt.
                       Replaces legacy BatchBlockSummary.aspx "Edit Sample" → SubmissionDetailsBlock.aspx. *@
                    <form method="post" asp-page-handler="Select" class="govuk-!-display-inline">
                        <input type="hidden" name="animalId" value="@a.ID" />
                        <button type="submit" class="govuk-button govuk-!-margin-bottom-0">Edit sample</button>
                    </form>
                    @* "Tissues" — navigates to animal/submission details editing. *@
                    <form method="post" asp-page-handler="Edit" class="govuk-!-display-inline">
                        <input type="hidden" name="animalId" value="@a.ID" />
                        <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0">Tissues</button>
                    </form>
                    @if (Model.CanModifySamples)
                    {
                        @* "Copy sample" — replaces legacy btnCopySubmission_Click, which redirected to AddSample.aspx
                           with the source animal's data pre-filled. The migrated AddSample page only carries the
                           Sender Ref forward (its other legacy fields were already dropped — see AddSampleModel),
                           so copying passes the source Sender Ref as a query parameter to pre-fill the Add Sample form. *@
                        <a asp-page="/Submissions/AddSample" asp-route-senderRef="@a.SenderRef"
                           class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0">Copy sample</a>
                        @* "Delete sample" — replaces legacy BatchBlockSummary.aspx "Delete Sample". *@
                        <form method="post" asp-page-handler="Delete" class="govuk-!-display-inline">
                            <input type="hidden" name="animalId" value="@a.ID" />
                            <button type="submit" class="govuk-button govuk-button--warning govuk-!-margin-bottom-0"
                                    onclick="return confirm('Delete this sample?')">Delete sample</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (!Model.Animals.Any())
        {
            <tr class="govuk-table__row"><td colspan="4" class="govuk-table__cell">No samples in this submission.</td></tr>
        }
    </tbody>
</table>

@* "Done" — replaces legacy BatchBlockSummary.aspx btnCancel Text="Done" → BatchDetails.aspx. *@
<a asp-page="/Batches/BatchDetails" class="govuk-button govuk-button--secondary" data-module="govuk-button">Done</a>

@* "Bypass sort" — legacy chkByPassSort: when checked, animals display in block-insertion order
   instead of the default SenderRef / HistologyRef ascending order. *@
<form method="post" asp-page-handler="ToggleByPassSort" class="govuk-!-margin-top-4">
    <div class="govuk-checkboxes" data-module="govuk-checkboxes">
        <div class="govuk-checkboxes__item">
            <input class="govuk-checkboxes__input" id="byPassSort" type="checkbox"
                   name="byPassSort" @(Model.Batch?.ByPassSort == true ? "checked" : "")
                   onchange="this.form.submit()" />
            <label class="govuk-label govuk-checkboxes__label" for="byPassSort">Bypass sort</label>
        </div>
    </div>
</form>
