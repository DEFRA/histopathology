@page
@model SearchUnUsedHistologyRefsModel
@{
    ViewData["Title"] = "Unused histology refs";
    ViewData["PageTitle"] = "Unused histology refs";
}

@section BeforeHeading {
    <a asp-page="/Search/SearchMenu" class="govuk-back-link">Back</a>
}

@if (Model.Results.Any())
{
    <table class="govuk-table">
        <caption class="govuk-table__caption govuk-table__caption--m govuk-visually-hidden">Unused histology refs</caption>
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                @{ ViewData["Label"] = "Histology ref"; ViewData["Column"] = "Ref"; }
                <partial name="_SortableHeader" />
               @*  @{ ViewData["Label"] = "Sender ref"; ViewData["Column"] = "SenderRef"; }
                <partial name="_SortableHeader" /> *@
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var r in Model.PagedResults)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@r.Ref</td>
                  @*   <td class="govuk-table__cell">@r.SenderRef</td> *@
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Pagination" />

    <a asp-page="/Search/SearchUnUsedHistologyRefs" asp-page-handler="ExportCsv"
       class="govuk-button govuk-button--secondary" data-module="govuk-button">Export to excel</a>
}
else
{
    <p class="govuk-body">No unused histology refs found.</p>
}
