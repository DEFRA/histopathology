@page
@model SearchBlockRefsModel
@{
    ViewData["Title"] = "Search block refs";
    ViewData["PageTitle"] = "Search block refs";
}

@section BeforeHeading {
    <a asp-page="/Search/SearchMenu" class="govuk-back-link">Back</a>
}

<partial name="_ErrorSummary" model="Model.Errors" />

@* GET so the search is bookmarkable and deep-linkable, matching the legacy page's
   Request.QueryString("SenderRef"/"HistologyRef") support, and so the sort/paging
   links below preserve the criteria. *@
<form method="get">
    <input type="hidden" name="Submitted" value="true" />
    <div class="govuk-form-group @(Model.Errors.ContainsKey("SenderRef") ? "govuk-form-group--error" : "")">
        <label class="govuk-label" for="SenderRef">Sender ref</label>
        @if (Model.Errors.TryGetValue("SenderRef", out var senderErr))
        {
            <p id="SenderRef-error" class="govuk-error-message"><span class="govuk-visually-hidden">Error:</span> @senderErr</p>
        }
        <input class="govuk-input govuk-input--width-20 @(Model.Errors.ContainsKey("SenderRef") ? "govuk-input--error" : "")"
               asp-for="SenderRef"
               aria-describedby="@(Model.Errors.ContainsKey("SenderRef") ? "SenderRef-error" : null)" />
    </div>
    <div class="govuk-form-group">
        <label class="govuk-label" for="HistologyRef">Histology ref</label>
        <input class="govuk-input govuk-input--width-20" asp-for="HistologyRef" />
    </div>
    <button type="submit" class="govuk-button" data-module="govuk-button">Search</button>
</form>

@if (Model.Errors.Count == 0)
{
    @if (Model.Results.Any())
    {
        <table class="govuk-table">
        <caption class="govuk-table__caption govuk-table__caption--m govuk-visually-hidden">Block refs matching the search criteria</caption>
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                @{ ViewData["Label"] = "Used block refs"; ViewData["Column"] = "UsedBlockRefs"; }
                <partial name="_SortableHeader" />
                @{ ViewData["Label"] = "Unused block refs"; ViewData["Column"] = "UnusedBlockRefs"; }
                <partial name="_SortableHeader" />
                @{ ViewData["Label"] = "Pre booked block refs"; ViewData["Column"] = "PreBookedBlockRefs"; }
                <partial name="_SortableHeader" />
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var r in Model.PagedResults)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@r.UsedBlockRefs</td>
                    <td class="govuk-table__cell">@r.UnusedBlockRefs</td>
                    <td class="govuk-table__cell">@r.PreBookedBlockRefs</td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Pagination" />

    <div class="govuk-button-group">
        <a asp-page="/Search/SearchBlockRefs" asp-page-handler="ExportCsv"
           asp-route-SenderRef="@Model.SenderRef" asp-route-HistologyRef="@Model.HistologyRef"
               class="govuk-button govuk-button--secondary" data-module="govuk-button">Export to excel</a>
        @* Legacy lbViewImportedData opened ViewImportedData.aspx?SearchString=<ref> in a popup.
           The migrated page names that parameter Filter and needs a table chosen there. *@
        <a asp-page="/Search/ViewImportedData"
           asp-route-Filter="@(Model.SenderRef ?? Model.HistologyRef)"
           class="govuk-link">View old ICC_Sub data</a>
    </div>
    }
    else if (Model.Searched)
    {
        <p class="govuk-body">No block refs found for the given criteria.</p>
    }
}