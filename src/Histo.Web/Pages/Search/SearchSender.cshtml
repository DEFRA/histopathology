@page
@model SearchSenderModel
@{
    // Title is set by the model (differs between picker mode and standalone search).
}

@section BeforeHeading {
    @if (Model.IsPickerMode && Model.ReturnId.HasValue)
    {
        @* Only CopyBatch currently passes ReturnId, and it expects the sourceBatchId route param. *@
        <a asp-page="/Batches/CopyBatch" asp-route-sourceBatchId="@Model.ReturnId" class="govuk-back-link">Back</a>
    }
    else if (Model.IsPickerMode)
    {
        <a asp-page="@Model.ReturnPage" class="govuk-back-link">Back</a>
    }
    else
    {
        <a asp-page="/Search/SearchMenu" class="govuk-back-link">Back</a>
    }
}

<form method="post" asp-antiforgery="true">
    @* Preserve picker params across the search POST so Select buttons and back link render correctly. *@
    @if (Model.IsPickerMode)
    {
        <input type="hidden" name="ReturnPage" value="@Model.ReturnPage" />
        <input type="hidden" name="ReturnId"   value="@Model.ReturnId" />
        <input type="hidden" name="RowIndex"   value="@Model.RowIndex" />
    }
    <div class="govuk-form-group">
        <label class="govuk-label" for="SenderRef">Sender ref</label>
        <div class="govuk-hint">Leave this blank to browse all sender references.</div>
        <input class="govuk-input govuk-input--width-20" asp-for="SenderRef" />
    </div>
    <button type="submit" class="govuk-button" data-module="govuk-button">Search</button>
</form>

@if (Model.Results.Any())
{
    @if (Model.IsPickerMode)
    {
        <p class="govuk-body">The following matches were found for your sample reference. Select the required reference, or click Back to return to the previous page.</p>
    }
    <table class="govuk-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Sender ref</th>
                <th scope="col" class="govuk-table__header">Histology ref</th>
                @if (Model.IsPickerMode)
                {
                    <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Select</span></th>
                }
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            @foreach (var r in Model.PagedResults)
            {
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">@r.SenderRef</td>
                    <td class="govuk-table__cell">@r.HistologyRef</td>
                    @if (Model.IsPickerMode)
                    {
                        <td class="govuk-table__cell">
                            <form method="post" asp-page-handler="Select">
                                <input type="hidden" name="selectedSenderRef" value="@r.SenderRef" />
                                <input type="hidden" name="returnPage" value="@Model.ReturnPage" />
                                <input type="hidden" name="returnId"   value="@Model.ReturnId" />
                                <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0">Select</button>
                            </form>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Pagination" />
}
else if (Model.HasSearched)
{
    <p class="govuk-body">No matching senders found for the given Sender Ref.</p>
}
