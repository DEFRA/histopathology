@page
@model Histo.Web.Pages.Bookings.BookHistologyRefModel
@{
    ViewData["Title"] = "Book Non-PG histology ref";
    ViewData["PageTitle"] = "Book Non-PG histology ref";
}

@section BeforeHeading {
    <a asp-page="/Bookings/BookingMenu" class="govuk-back-link">Back</a>
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    <li>@Model.Error</li>
                </ul>
            </div>
        </div>
    </div>
}

<form method="post">
    <div class="govuk-form-group">
        <label class="govuk-label" for="histoRef">Select reference</label>
        <select name="histoRef" id="histoRef" class="govuk-select" required>
            <option value="">-- Select --</option>
            @foreach (var r in Model.AvailableRefs)
            {
                <option value="@r.Ref">@r.Ref</option>
            }
        </select>
    </div>
    <button type="submit" class="govuk-button" data-module="govuk-button">Book</button>
    <a asp-page="/Submissions/SampleSummary" class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</a>
</form>

<p class="govuk-body"><a asp-page="/Search/SearchBlockRefs" class="govuk-link">Check Used Block Refs</a></p>
