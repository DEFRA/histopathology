@page
@model Histo.Web.Pages.Bookings.BookBlockRefModel
@{
    ViewData["Title"] = "Book blocks";
    ViewData["PageTitle"] = "Book blocks";
}

@section BeforeHeading {
    <a asp-page="/Bookings/BookingMenu" class="govuk-back-link">Back</a>
}

<table class="govuk-table">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Block ref</th>
            <th scope="col" class="govuk-table__header">Customer ref</th>
            <th scope="col" class="govuk-table__header">Action</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var b in Model.PreBookedBlocks)
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@b.BlockRef</td>
                <td class="govuk-table__cell">@b.CustomerRef</td>
                <td class="govuk-table__cell">
                    <form method="post">
                        <input type="hidden" name="blockId" value="@b.ID" />
                        <button type="submit" class="govuk-button govuk-!-margin-bottom-0" data-module="govuk-button">Book</button>
                    </form>
                </td>
            </tr>
        }
        @if (!Model.PreBookedBlocks.Any())
        {
            <tr class="govuk-table__row"><td colspan="3" class="govuk-table__cell">No pre-booked blocks found.</td></tr>
        }
    </tbody>
</table>
<a asp-page="/Bookings/BookingMenu" class="govuk-button govuk-button--secondary" data-module="govuk-button">Back</a>
