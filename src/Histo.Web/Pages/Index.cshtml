@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
    ViewData["PageTitle"] = "Home";
}

<div class="govuk-grid-row">

    @* Customer panel *@
    @if (Model.Session.IsCustomer || Model.Session.IsHistoUser || Model.Session.IsMaintenance)
    {
        <div class="govuk-grid-column-one-third">
            <h2 class="govuk-heading-m">Submissions</h2>
            <ul class="govuk-list">
                <li><a class="govuk-link" asp-page="/Submissions/AddSubmission">New submission</a></li>
                <li><a class="govuk-link" asp-page="/Submissions/ViewSubmissions">View submissions</a></li>
            </ul>
        </div>
    }

    @* Histopathology User / Maintenance panel *@
    @if (Model.Session.IsHistoUser || Model.Session.IsMaintenance)
    {
        <div class="govuk-grid-column-one-third">
            <h2 class="govuk-heading-m">Laboratory</h2>
            <ul class="govuk-list">
                <li><a class="govuk-link" asp-page="/Batches/BatchesNotReceived">Receive batches</a></li>
                <li><a class="govuk-link" asp-page="/Batches/BatchesReceived">Batches received</a></li>
                <li><a class="govuk-link" asp-page="/Batches/BatchesForEditing">Edit batches</a></li>
                <li><a class="govuk-link" asp-page="/Batches/BatchesForDispatch">Dispatch batches</a></li>
                <li><a class="govuk-link" asp-page="/Batches/BatchesForArchiving">Archive batches</a></li>
            </ul>
        </div>

        <div class="govuk-grid-column-one-third">
            <h2 class="govuk-heading-m">Search and reports</h2>
            <ul class="govuk-list">
                <li><a class="govuk-link" asp-page="/Search/SearchMenu">Search submissions</a></li>
                <li><a class="govuk-link" asp-page="/Search/SearchSample">Search samples</a></li>
                <li><a class="govuk-link" asp-page="/Search/SearchBlockRefs">Search block refs</a></li>
                <li><a class="govuk-link" asp-page="/QC/QCNotes">Quality data</a></li>
                <li><a class="govuk-link" asp-page="/AuditLog/AuditLogMenu">Audit log</a></li>
            </ul>
        </div>

        <div class="govuk-grid-column-one-third">
            <h2 class="govuk-heading-m">Bookings and archive</h2>
            <ul class="govuk-list">
                <li><a class="govuk-link" asp-page="/Bookings/BookingMenu">Book histology refs</a></li>
                <li><a class="govuk-link" asp-page="/Archive/ArchiveMenu">Archive</a></li>
            </ul>
        </div>
    }

    @* Maintenance only *@
    @if (Model.Session.IsMaintenance)
    {
        <div class="govuk-grid-column-one-third">
            <h2 class="govuk-heading-m">Administration</h2>
            <ul class="govuk-list">
                <li><a class="govuk-link" asp-page="/Admin/UserMaintenance">User maintenance</a></li>
                <li><a class="govuk-link" asp-page="/Admin/PickListMaintenance">Pick lists</a></li>
            </ul>
        </div>
    }

</div>

