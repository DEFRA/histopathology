@page
@model Histo.Web.Pages.Blocks.CopySamplesModel
@{
    ViewData["Title"] = "Copy samples";
    ViewData["PageTitle"] = "Copy samples";
}

@section BeforeHeading {
    <a asp-page="/Submissions/SubmissionDetailsBlock" class="govuk-back-link">Back</a>
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    <li>@Model.Error</li>
                </ul>
            </div>
        </div>
    </div>
}

<form method="post" asp-page-handler="Find">
    <div class="govuk-form-group">
        <label class="govuk-label" for="SourceBatchId">Submission number to copy samples from</label>
        <input class="govuk-input govuk-input--width-5" asp-for="SourceBatchId" />
    </div>
    <button type="submit" class="govuk-button" data-module="govuk-button">Find submission</button>
</form>

@if (Model.SourceBatch is not null)
{
    <form method="post" asp-page-handler="Copy">
        <input type="hidden" asp-for="SourceBatchId" />

        <div class="govuk-form-group">
            <fieldset class="govuk-fieldset">
                <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">Sample to copy from submission @Model.SourceBatch.ID</legend>
                <div class="govuk-radios" data-module="govuk-radios">
                    @foreach (var a in Model.SourceAnimals)
                    {
                        <div class="govuk-radios__item">
                            <input class="govuk-radios__input" type="radio" name="SourceAnimalId" value="@a.ID" id="source-@a.ID" />
                            <label class="govuk-label govuk-radios__label" for="source-@a.ID">@a.SenderRef</label>
                        </div>
                    }
                </div>
            </fieldset>
        </div>

        <div class="govuk-form-group">
            <fieldset class="govuk-fieldset">
                <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">Copy blocks to sample(s) in the current submission</legend>
                <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                    @foreach (var a in Model.TargetAnimals)
                    {
                        <div class="govuk-checkboxes__item">
                            <input class="govuk-checkboxes__input" type="checkbox" name="TargetAnimalIds" value="@a.ID" id="target-@a.ID" />
                            <label class="govuk-label govuk-checkboxes__label" for="target-@a.ID">@a.SenderRef</label>
                        </div>
                    }
                    @if (!Model.TargetAnimals.Any())
                    {
                        <p class="govuk-body">No samples are available in the current submission to copy blocks to.</p>
                    }
                </div>
            </fieldset>
        </div>

        @if (Model.SourceAnimals.Any() && Model.TargetAnimals.Any())
        {
            <button type="submit" class="govuk-button" data-module="govuk-button">Copy samples</button>
        }
    </form>
}

<form method="post" asp-page-handler="Cancel">
    <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</button>
</form>
