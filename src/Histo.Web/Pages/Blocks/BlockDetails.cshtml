@page
@model Histo.Web.Pages.Blocks.BlockDetailsModel
@{
    ViewData["Title"] = !Model.IsAddFlow && Model.IsEditMode ? "Edit block" : "Add block";
    ViewData["PageTitle"] = ViewData["Title"];
}

@section BeforeHeading {
    @if (Model.IsAddFlow)
    {
        @* Legacy: btnCancel_Click discards a newly-provisioned block entirely rather than leaving
           an empty row behind — the plain Back link had no way to do this, so Back silently left
           an orphan block whenever the user left without adding anything. Posts a separate,
           genuinely hidden <form> below (via the form= attribute) rather than nesting the button
           inside an inline-display form — that nesting was the cause of the back-link's visual
           overlap with the page heading. *@
        <button type="submit" form="cancel-add-block-form" class="govuk-back-link app-back-link-button">Back</button>
    }
    else
    {
        <a asp-page="/Submissions/SubmissionDetailsBlock" asp-route-BatchId="@Model.BatchId" asp-route-AnimalId="@Model.AnimalId" class="govuk-back-link">Back</a>
    }

}

@if (Model.IsAddFlow)
{
    @* Plain name/value (not asp-for) — the main Add/Edit form below already has asp-for
       inputs for these same properties; asp-for here would emit duplicate element IDs.
       IsAddFlow must be restated here too — without it, this POST always binds IsAddFlow to its
       default (false), so OnPostCancelAsync's "still in add flow" guard never fires and the
       auto-provisioned block is never deleted when Back is clicked. *@
    <form method="post" asp-page-handler="Cancel" asp-antiforgery="true" id="cancel-add-block-form" class="govuk-visually-hidden">
        <input type="hidden" name="BatchId" value="@Model.BatchId" />
        <input type="hidden" name="AnimalId" value="@Model.AnimalId" />
        <input type="hidden" name="BlockId" value="@Model.BlockId" />
        @* Booleans are written as "true"/"false": value="@bool" renders value="value" for true, which never binds. *@
        <input type="hidden" name="IsAddFlow" value="@(Model.IsAddFlow ? "true" : "false")" />
        <input type="hidden" name="IsFromNextBlock" value="@(Model.IsFromNextBlock ? "true" : "false")" />
    </form>
}

@if (Model.Animal is null)
{
    <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
            <span class="govuk-visually-hidden">Warning</span>
            Sample not found.
        </strong>
    </div>
    <a asp-page="/Submissions/SampleSummary" asp-route-BatchId="@Model.BatchId" class="govuk-button govuk-button--secondary" data-module="govuk-button">Back to samples</a>
}
else if (Model.IsEditMode && Model.Block is null)
{
    <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
            <span class="govuk-visually-hidden">Warning</span>
            Block not found.
        </strong>
    </div>
    <a asp-page="/Submissions/SubmissionDetailsBlock" asp-route-BatchId="@Model.BatchId" asp-route-AnimalId="@Model.AnimalId" class="govuk-button govuk-button--secondary" data-module="govuk-button">Back to blocks</a>
}
else
{
    @if (Model.ErrorMessage is not null)
    {
        <div class="govuk-error-summary" data-module="govuk-error-summary">
            <div role="alert">
                <h2 class="govuk-error-summary__title">There is a problem</h2>
                <div class="govuk-error-summary__body">
                    <ul class="govuk-list govuk-error-summary__list"><li>@Model.ErrorMessage</li></ul>
                </div>
            </div>
        </div>
        @if (Model.NoPreBookedRefsAvailable)
        {
            <p class="govuk-body">
                <a asp-page="/Bookings/BookBlockRef" class="govuk-link">Book a block reference</a>
            </p>
        }
    }

    <form method="post" asp-page-handler="Done" id="block-details-form">
        <input type="hidden" asp-for="BatchId" />
        <input type="hidden" asp-for="AnimalId" />
        <input type="hidden" asp-for="IsAddFlow" />
        <input type="hidden" asp-for="IsFromNextBlock" />
        @if (Model.IsEditMode)
        {
            <input type="hidden" asp-for="BlockId" />
        }
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group">
                    <span class="govuk-label">Sender ref</span>
                    <p class="govuk-body govuk-!-font-weight-bold">@Model.Animal.SenderRef</p>
                </div>
                <div class="govuk-form-group">
                    <label class="govuk-label" for="NewBlockRef">Block ref</label>
                    @if (Model.IsPreCassetted && Model.IsAddFlow)
                    {
                        <div class="govuk-hint">Pre-cassetted submission — defaults to the next pre-booked block reference. Change it if you need to use a different pre-booked reference.</div>
                    }
                    else if (!Model.IsPreCassetted)
                    {
                        <div id="NewBlockRef-hint" class="govuk-hint">To re-use blocks this sender ref already has on another submission, enter the first block ref and the number of blocks.</div>
                    }
                    <input class="govuk-input govuk-input--width-3" asp-for="NewBlockRef" maxlength="3" aria-describedby="@(Model.IsPreCassetted ? null : "NewBlockRef-hint")" />
                </div>
                <div class="govuk-form-group">
                    <label class="govuk-label" for="NewNumberOfBlocks">Number of blocks</label>
                    <div class="govuk-hint">Number of blocks containing the same tissues and tests.</div>
                    <input class="govuk-input govuk-input--width-3" asp-for="NewNumberOfBlocks" maxlength="3" inputmode="numeric" />
                </div>
                
            </div>
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group">
                    <span class="govuk-label" id="histology-ref-label">Histology reference</span>
                    <p class="govuk-body govuk-!-font-weight-bold" aria-labelledby="histology-ref-label">@(string.IsNullOrWhiteSpace(Model.Animal.HistologyRef) ? "—" : Model.Animal.HistologyRef)</p>
                </div>
                <div class="govuk-form-group">
                    <label class="govuk-label" for="NewCustomerRef">Customer reference</label>
                    <input class="govuk-input govuk-input--width-20" asp-for="NewCustomerRef" />
                </div>
                <div class="govuk-form-group">
                    <div class="govuk-checkboxes" data-module="govuk-checkboxes">
                        <div class="govuk-checkboxes__item">
                            @if (Model.CanUseAdditionalRequest)
                            {
                                <input class="govuk-checkboxes__input" asp-for="NewRepeatBlock" type="checkbox" />
                                <label class="govuk-label govuk-checkboxes__label" for="NewRepeatBlock">Additional request (repeat block)</label>
                            }
                            else
                            {
                                <input class="govuk-checkboxes__input" id="NewRepeatBlockUnavailable" type="checkbox" disabled />
                                <input type="hidden" asp-for="NewRepeatBlock" value="false" />
                                <label class="govuk-label govuk-checkboxes__label" for="NewRepeatBlockUnavailable">Additional request (repeat block)</label>
                            }
                        </div>
                    </div>
                    @if (!Model.CanUseAdditionalRequest)
                    {
                        <div class="govuk-hint">Not available for this submission type.</div>
                    }
                </div>
            </div>
        </div>
    </form>

    @if (Model.Block is not null)
    {
        @* Add and Delete tissue keep the block fields typed above (see the script below). Edit tissue,
           Save tissue and Cancel reload from the saved block, so unsaved changes are discarded there. *@
        <div class="govuk-warning-text">
            <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
            <strong class="govuk-warning-text__text">
                <span class="govuk-visually-hidden">Warning</span>
                Adding or deleting a tissue keeps your changes to this block. Editing a tissue, or selecting a link that reloads the page, discards unsaved changes to Block ref, Number of blocks, Customer reference, Comments or Tests unless you select Done first.
            </strong>
        </div>

        <h2 class="govuk-heading-m">Tissues</h2>
        <table class="govuk-table">
            <thead class="govuk-table__head">
                <tr class="govuk-table__row">
                    <th scope="col" class="govuk-table__header">Tissue</th>
                    <th scope="col" class="govuk-table__header">No. pieces</th>
                    <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Action</span></th>
                </tr>
            </thead>
            <tbody class="govuk-table__body">
                @foreach (var t in Model.Tissues)
                {
                    @if (Model.EditTissueId == t.ID)
                    {
                        <tr class="govuk-table__row">
                            <td class="govuk-table__cell" colspan="3">
                                <form method="post" asp-page-handler="UpdateTissue">
                                    <input type="hidden" asp-for="BatchId" />
                                    <input type="hidden" asp-for="AnimalId" />
                                    <input type="hidden" asp-for="BlockId" />
                                    <input type="hidden" asp-for="IsAddFlow" />
                                    <input type="hidden" asp-for="IsFromNextBlock" />
                                    <input type="hidden" asp-for="UseWholeTissueList" />
                                    <input type="hidden" name="CarryTestsToNextBlock" value="@(Model.CarryTestsToNextBlock ? "true" : "false")" />
                                    <input type="hidden" asp-for="TissueId" />
                                    <div class="govuk-form-group">
                                        <label class="govuk-label" for="EditTissueCode">Tissue type</label>
                                        <select class="govuk-select" asp-for="EditTissueCode">
                                            @foreach (var opt in Model.EditTissueOptions)
                                            {
                                                <option value="@opt.Code">@opt.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="govuk-form-group">
                                        <label class="govuk-label" for="EditNoPieces">Number of pieces</label>
                                        <input class="govuk-input govuk-input--width-3" asp-for="EditNoPieces" />
                                    </div>
                                    <div class="govuk-button-group">
                                        <button type="submit" class="govuk-button" data-module="govuk-button">Save tissue</button>
                                        <a asp-page="/Blocks/BlockDetails" asp-route-BatchId="@Model.BatchId" asp-route-AnimalId="@Model.AnimalId" asp-route-BlockId="@Model.BlockId" asp-route-IsAddFlow="@Model.IsAddFlow" asp-route-IsFromNextBlock="@Model.IsFromNextBlock" asp-route-UseWholeTissueList="@Model.UseWholeTissueList" asp-route-CarryTestsToNextBlock="@Model.CarryTestsToNextBlock" class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</a>
                                    </div>
                                </form>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr class="govuk-table__row">
                            <td class="govuk-table__cell">@(Model.EditTissueOptions.FirstOrDefault(o => o.Code == t.TissueCode)?.Name ?? t.TissueCode)</td>
                            <td class="govuk-table__cell">@t.NoPieces</td>
                            <td class="govuk-table__cell">
                                <div class="govuk-button-group govuk-!-margin-bottom-0">
                                    <a asp-page="/Blocks/BlockDetails" asp-route-BatchId="@Model.BatchId" asp-route-AnimalId="@Model.AnimalId" asp-route-BlockId="@Model.BlockId"
                                       asp-route-EditTissueId="@t.ID" asp-route-IsAddFlow="@Model.IsAddFlow" asp-route-IsFromNextBlock="@Model.IsFromNextBlock" asp-route-UseWholeTissueList="@Model.UseWholeTissueList" asp-route-CarryTestsToNextBlock="@Model.CarryTestsToNextBlock" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button">Edit</a>
                                    @* display:contents removes the form from the flex layout so the button
                                       itself is the flex item, aligning it with the Edit link. *@
                                    <form method="post" asp-page-handler="DeleteTissue" style="display:contents" data-keep-block-fields>
                                        <input type="hidden" name="BatchId" value="@Model.BatchId" />
                                        <input type="hidden" name="AnimalId" value="@Model.AnimalId" />
                                        <input type="hidden" name="BlockId" value="@Model.BlockId" />
                                        <input type="hidden" name="IsAddFlow" value="@(Model.IsAddFlow ? "true" : "false")" />
                                        <input type="hidden" name="IsFromNextBlock" value="@(Model.IsFromNextBlock ? "true" : "false")" />
                                        <input type="hidden" name="UseWholeTissueList" value="@(Model.UseWholeTissueList ? "true" : "false")" />
                                        <partial name="_BlockCarryFields" model="Model" />
                                        <input type="hidden" name="tissueId" value="@t.ID" />
                                        <button type="submit" class="govuk-button govuk-button--warning govuk-!-margin-bottom-0" data-module="govuk-button">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                @if (!Model.Tissues.Any())
                {
                    <tr class="govuk-table__row"><td colspan="3" class="govuk-table__cell">No tissues assigned to this block.</td></tr>
                }
            </tbody>
        </table>

        <form method="post" asp-page-handler="AddTissue" class="govuk-!-margin-bottom-6" data-keep-block-fields>
            <input type="hidden" asp-for="BatchId" />
            <input type="hidden" asp-for="AnimalId" />
            <input type="hidden" asp-for="BlockId" />
            <input type="hidden" asp-for="IsAddFlow" />
            <input type="hidden" asp-for="IsFromNextBlock" />
            <input type="hidden" asp-for="UseWholeTissueList" />
            <partial name="_BlockCarryFields" model="Model" />
            <div class="govuk-form-group">
                <label class="govuk-label" for="NewTissueCode">Tissue type</label>
                @if (Model.UseWholeTissueList)
                {
                    <div class="govuk-hint">
                        Showing every tissue type.
                        <a asp-page="/Blocks/BlockDetails" asp-route-BatchId="@Model.BatchId" asp-route-AnimalId="@Model.AnimalId" asp-route-BlockId="@Model.BlockId" asp-route-IsAddFlow="@Model.IsAddFlow" asp-route-IsFromNextBlock="@Model.IsFromNextBlock" asp-route-UseWholeTissueList="false" asp-route-CarryTestsToNextBlock="@Model.CarryTestsToNextBlock" class="govuk-link">Show only tissues used on this submission</a>
                    </div>
                }
                else
                {
                    <div class="govuk-hint">
                        Showing only tissue types already used on this submission.
                        <a asp-page="/Blocks/BlockDetails" asp-route-BatchId="@Model.BatchId" asp-route-AnimalId="@Model.AnimalId" asp-route-BlockId="@Model.BlockId" asp-route-IsAddFlow="@Model.IsAddFlow" asp-route-IsFromNextBlock="@Model.IsFromNextBlock" asp-route-UseWholeTissueList="true" asp-route-CarryTestsToNextBlock="@Model.CarryTestsToNextBlock" class="govuk-link">Show the entire tissue list</a>
                    </div>
                }
                <select class="govuk-select" asp-for="NewTissueCode">
                    <option value="">-- Select --</option>
                    @foreach (var t in Model.TissueOptions)
                    {
                        <option value="@t.Code">@t.Name</option>
                    }
                </select>
            </div>
            <div class="govuk-form-group">
                <label class="govuk-label" for="NewTissueNoPieces">Number of pieces</label>
                <input class="govuk-input govuk-input--width-3" asp-for="NewTissueNoPieces" />
            </div>
            <button type="submit" class="govuk-button" data-module="govuk-button">Add tissue</button>
        </form>

        <h2 class="govuk-heading-m">Tests</h2>
        <p class="govuk-hint">The first block for this sample starts with the tests selected for this submission; later blocks start unselected unless you tick "Use these tests for the next block?". Any changes are saved when you select Done or Next block.</p>
        <div>
        @{
            // Fields below use form="block-details-form" so they submit together with the block
            // details form above (via the single "Done" button) even though they sit outside it —
            // the Tissues table's own Add/Edit/Delete forms can't be nested between two <form> tags.
            // Options are already narrowed to the batch-level selection in BlockDetailsModel
            // (mirrors legacy's HideTests()) — rendering Model.HistologyOptions/AntibodyOptions/
            // StainOptions directly, not re-narrowed to this block's own saved codes, so a block
            // can always pick any test chosen at Create/Edit Submission time, not just ones it has
            // already saved.
            var histOptions = Model.HistologyOptions;
            var antibodyOptions = Model.AntibodyOptions;
            var stainOptions = Model.StainOptions;
        }
        @if (histOptions.Count == 0)
        {
            <p class="govuk-body">No test types are selected for this submission.</p>
        }
        else
        {
        <div class="govuk-grid-row">
        <div class="govuk-grid-column-one-third">
        <div class="govuk-form-group">
            <fieldset class="govuk-fieldset">
                <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">Histology</legend>
                <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes" id="block-histology-checkboxes">
                    @foreach (var opt in histOptions)
                    {
                        <div class="govuk-checkboxes__item">
                            <input class="govuk-checkboxes__input" type="checkbox" name="SelectedHistologyCodes" form="block-details-form"
                                   id="hist-@opt.Code" value="@opt.Code" data-histology-code="@opt.Code"
                                   @(Model.ExistingHistologyCodes.Contains(opt.Code ?? "") ? "checked" : "") />
                            <label class="govuk-label govuk-checkboxes__label" for="hist-@opt.Code">@opt.Name</label>
                        </div>
                    }
                </div>
            </fieldset>
        </div>
        </div>
        <div class="govuk-grid-column-one-third">
        <div class="govuk-form-group">
            <fieldset class="govuk-fieldset">
                <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">Antibodies</legend>
                <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes" id="block-antibodies-section" style="@(Model.ShowAntibodies ? "" : "display:none")">
                    @foreach (var opt in antibodyOptions)
                    {
                        <div class="govuk-checkboxes__item">
                            <input class="govuk-checkboxes__input" type="checkbox" name="SelectedAntibodyCodes" form="block-details-form"
                                   id="ab-@opt.Code" value="@opt.Code" @(Model.ExistingAntibodyCodes.Contains(opt.Code ?? "") ? "checked" : "")
                                   @(Model.AntibodiesEnabled ? "" : "disabled") />
                            <label class="govuk-label govuk-checkboxes__label" for="ab-@opt.Code">@opt.Name</label>
                        </div>
                    }
                </div>
            </fieldset>
        </div>
        </div>
        <div class="govuk-grid-column-one-third">
        <div class="govuk-form-group">
            <fieldset class="govuk-fieldset">
                <legend class="govuk-fieldset__legend govuk-fieldset__legend--s">Special stain</legend>
                <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes" id="block-stains-section" style="@(Model.ShowStains ? "" : "display:none")">
                    @foreach (var opt in stainOptions)
                    {
                        <div class="govuk-checkboxes__item">
                            <input class="govuk-checkboxes__input" type="checkbox" name="SelectedStainCodes" form="block-details-form"
                                   id="stain-@opt.Code" value="@opt.Code" @(Model.ExistingStainCodes.Contains(opt.Code ?? "") ? "checked" : "")
                                   @(Model.StainsEnabled ? "" : "disabled") />
                            <label class="govuk-label govuk-checkboxes__label" for="stain-@opt.Code">@opt.Name</label>
                        </div>
                    }
                </div>
            </fieldset>
        </div>
        </div>
        </div>
        }
        </div>

        <div class="govuk-form-group">
            <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
                <div class="govuk-checkboxes__item">
                    @* Plain name/value/checked (not asp-for) — asp-for on a non-nullable bool checkbox
                       emits data-val-required ("field is required"), which is wrong for this genuinely
                       optional opt-in checkbox; bool? isn't supported by the checkbox tag helper either. *@
                    <input class="govuk-checkboxes__input" type="checkbox" id="CarryTestsToNextBlock" name="CarryTestsToNextBlock"
                           value="true" form="block-details-form" @(Model.CarryTestsToNextBlock ? "checked" : "") />
                    <label class="govuk-label govuk-checkboxes__label" for="CarryTestsToNextBlock">Use these tests for the next block?</label>
                </div>
            </div>
            <div class="govuk-hint">Saves this block's tests, then creates the next block for this sample.</div>
        </div>

        <div class="govuk-form-group govuk-!-margin-top-6">
            <label class="govuk-label" for="NewComment">Comments and details of other tests</label>
            <textarea class="govuk-textarea" asp-for="NewComment" rows="3" form="block-details-form"></textarea>
        </div>

        <div class="govuk-button-group">
            <button type="submit" form="block-details-form" class="govuk-button" data-module="govuk-button">Done</button>
            @* formaction routes this button's submit of block-details-form to NextBlock instead of
               the form's default Done handler — the live Tests checkboxes above (form="block-details-form")
               are then genuinely part of this submission instead of a separate, stale snapshot.
               Placed after Done (not before) so Done — the primary action — stays the browser's
               implicit-Enter-key default for this form; GOV.UK convention also lists the primary
               action first. *@
            <button type="submit" form="block-details-form" formaction="?handler=NextBlock" class="govuk-button govuk-button--secondary" data-module="govuk-button">Next block</button>
            @* Explicit, labelled discard action alongside Done/Next block — matches every other
               form page in this app (Cancel button next to the primary action) and the Help page's
               own documented text ("Select Cancel to discard the data..."), rather than relying on
               the ambiguous top-of-page Back link alone. *@
            @if (Model.IsAddFlow)
            {
                <button type="submit" form="cancel-add-block-form" class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</button>
            }
            else
            {
                <a asp-page="/Submissions/SubmissionDetailsBlock" asp-route-BatchId="@Model.BatchId" asp-route-AnimalId="@Model.AnimalId" class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</a>
            }
        </div>
    }

@section Scripts {
    <script>
        // Add/Delete tissue are separate forms from block-details-form, so copy the block fields the
        // user has typed into them on submit; BlockDetailsModel stashes them and restores them after the redirect.
        (function () {
            var main = document.getElementById('block-details-form');
            if (!main) return;
            var names = ['NewBlockRef', 'NewNumberOfBlocks', 'NewCustomerRef', 'NewRepeatBlock', 'NewComment',
                'SelectedHistologyCodes', 'SelectedAntibodyCodes', 'SelectedStainCodes', 'CarryTestsToNextBlock'];
            document.querySelectorAll('form[data-keep-block-fields]').forEach(function (form) {
                form.addEventListener('submit', function () {
                    var marker = document.createElement('input');
                    marker.type = 'hidden';
                    marker.name = 'BlockFieldsPosted';
                    marker.value = 'true';
                    form.appendChild(marker);
                    Array.prototype.forEach.call(main.elements, function (el) {
                        if (names.indexOf(el.name) === -1 || el.disabled) return;
                        if ((el.type === 'checkbox' || el.type === 'radio') && !el.checked) return;
                        var copy = document.createElement('input');
                        copy.type = 'hidden';
                        copy.name = el.name;
                        copy.value = el.value;
                        form.appendChild(copy);
                    });
                });
            });
        })();
    </script>
    <script>
        // Legacy-matching behaviour (BlockDetails.aspx.vb chkblHistology_SelectedIndexChanged):
        // EO and Archive are mutually exclusive with every other Histology test. Selecting either
        // one auto-deselects all other Histology checkboxes so the user doesn't hit a validation
        // error round-trip, and disables + clears Antibody/Special stain ticks too (legacy:
        // DisableAntibodies/DisableSpecialStains) since neither applies once EO/Archive is picked.
        // Checking Special Stain/IHC-PrP/IHC-Other enables its dependent column's checkboxes;
        // unchecking disables them and clears any ticks (legacy's "Else" branch of each check,
        // chkblAntibodies.Enabled/chkblSpecialStain.Enabled) — a block can otherwise still submit
        // stale Antibody/Stain codes with no Histology code left selected to justify them. The
        // Antibodies/Special stain SECTIONS themselves stay visible regardless of enabled state
        // (Model.ShowAntibodies/ShowStains) — they must always offer every batch-level option.
        (function () {
            var group = document.getElementById('block-histology-checkboxes');
            if (!group) return;
            var exclusiveCodes = ['1', '7']; // EO, Archive
            var specialStainCode = '3';
            var antibodyTriggerCodes = ['4', '6']; // IHC-PrP, IHC-Other
            var antibodiesSection = document.getElementById('block-antibodies-section');
            var stainsSection = document.getElementById('block-stains-section');

            function setSectionDisabled(section, disabled) {
                if (!section) return;
                section.querySelectorAll('input[type="checkbox"]').forEach(function (cb) {
                    cb.disabled = disabled;
                    if (disabled) cb.checked = false;
                });
            }

            function disableAntibodiesAndStains() {
                setSectionDisabled(antibodiesSection, true);
                setSectionDisabled(stainsSection, true);
            }

            group.addEventListener('change', function (e) {
                var target = e.target;
                if (!target || !target.matches('input[type="checkbox"]')) {
                    return;
                }
                var code = target.dataset.histologyCode;
                var checkboxes = group.querySelectorAll('input[type="checkbox"]');
                var isExclusive = exclusiveCodes.indexOf(code) !== -1;
                if (target.checked && isExclusive) {
                    checkboxes.forEach(function (cb) {
                        if (cb !== target) {
                            cb.checked = false;
                        }
                    });
                    disableAntibodiesAndStains();
                } else if (target.checked && !isExclusive) {
                    checkboxes.forEach(function (cb) {
                        if (cb !== target && exclusiveCodes.indexOf(cb.dataset.histologyCode) !== -1) {
                            cb.checked = false;
                        }
                    });
                    if (code === specialStainCode) {
                        setSectionDisabled(stainsSection, false);
                    } else if (antibodyTriggerCodes.indexOf(code) !== -1) {
                        setSectionDisabled(antibodiesSection, false);
                    }
                } else if (!target.checked && code === specialStainCode) {
                    setSectionDisabled(stainsSection, true);
                } else if (!target.checked && antibodyTriggerCodes.indexOf(code) !== -1) {
                    setSectionDisabled(antibodiesSection, true);
                }
            });
        })();
    </script>
}

}
