@page
@model Histo.Web.Pages.Blocks.BlockDetailsModel
@{
    ViewData["Title"] = "Block details";
    ViewData["PageTitle"] = "Block details";
}

@section BeforeHeading {
    <a asp-page="/Submissions/BatchBlockSummary" class="govuk-back-link">Back</a>
}

<a asp-page="/Blocks/CopySamples" class="govuk-button govuk-button--secondary" data-module="govuk-button">Copy samples</a>

@* Inline GOV.UK confirmation panel — replaces the browser confirm() dialog for Delete. *@
@if (Model.ConfirmDeleteBlockId is int confirmBlockId)
{
    var confirmBlock = Model.Blocks.FirstOrDefault(b => b.ID == confirmBlockId);
    <div class="govuk-warning-text">
        <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
        <strong class="govuk-warning-text__text">
            <span class="govuk-visually-hidden">Warning</span>
            Are you sure you want to delete block @(confirmBlock?.BlockRef ?? "this block")?
        </strong>
    </div>
    <form method="post" asp-page-handler="Delete" class="govuk-!-display-inline">
        <input type="hidden" name="blockId" value="@confirmBlockId" />
        <button type="submit" class="govuk-button govuk-button--warning" data-module="govuk-button">Yes, delete block</button>
        <a asp-page="/Blocks/BlockDetails" class="govuk-button govuk-button--secondary" data-module="govuk-button">Cancel</a>
    </form>
}

<table class="govuk-table">
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Block ref</th>
            <th scope="col" class="govuk-table__header">Customer ref</th>
            <th scope="col" class="govuk-table__header">Comment</th>
            <th scope="col" class="govuk-table__header">Repeat</th>
            <th scope="col" class="govuk-table__header">Status</th>
            <th scope="col" class="govuk-table__header">Actions</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var b in Model.Blocks)
        {
            <tr class="govuk-table__row">
                <td class="govuk-table__cell">@b.BlockRef</td>
                <td class="govuk-table__cell">@b.CustomerRef</td>
                <td class="govuk-table__cell">@b.Comment</td>
                <td class="govuk-table__cell">@(b.RepeatBlock ? "Yes" : "No")</td>
                <td class="govuk-table__cell">@b.Status</td>
                <td class="govuk-table__cell">
                    @* "Delete" — links to the inline confirmation panel above instead of a browser confirm() dialog. *@
                    <a asp-page="/Blocks/BlockDetails" asp-route-ConfirmDeleteBlockId="@b.ID"
                       class="govuk-button govuk-button--warning govuk-!-margin-bottom-0">Delete</a>
                </td>
            </tr>
        }
        @if (!Model.Blocks.Any())
        {
            <tr class="govuk-table__row"><td colspan="6" class="govuk-table__cell">No blocks found for this batch.</td></tr>
        }
    </tbody>
</table>

<a asp-page="/Submissions/BatchBlockSummary" class="govuk-button govuk-button--secondary" data-module="govuk-button">Back to animals</a>
