@using Histo.Core.Domain
@*
    POST-variant of _Pagination for grids whose filter criteria are bound via
    [BindProperty] on a POST handler (e.g. ViewSubmissions), rather than the query
    string. Renders the identical « ‹ [page numbers] › » + "Page X of Y" control, but
    submits the page's existing hidden carrier form instead of navigating via a GET
    link, so POST-bound filter values are not lost when paging.

    Usage (render immediately after </table>):
        @{ ViewData["FormId"] = "view-action-form"; ViewData["Handler"] = "Search"; }
        <partial name="_PaginationPost" />

    Requires ViewData["CurrentPage"], ViewData["TotalPages"] (plus ViewData["SortColumn"]/
    ["SortDesc"] if the grid is also sortable) to have been set on the page before the table.
*@
@{
    var currentPage = ViewData["CurrentPage"] as int? ?? 1;
    var totalPages  = ViewData["TotalPages"] as int? ?? 1;
    var sortColumn  = ViewData["SortColumn"]?.ToString();
    var sortDesc    = ViewData["SortDesc"] as bool? ?? false;
    var formId      = ViewData["FormId"]?.ToString() ?? string.Empty;
    var handler     = ViewData["Handler"]?.ToString() ?? string.Empty;

    string BuildAction(int page)
    {
        var parts = new List<string> { $"handler={Uri.EscapeDataString(handler)}" };
        if (!string.IsNullOrEmpty(sortColumn))
        {
            parts.Add($"SortColumn={Uri.EscapeDataString(sortColumn)}");
            parts.Add($"SortDesc={(sortDesc ? "true" : "false")}");
        }
        parts.Add($"PageNumber={page}");
        return "?" + string.Join("&", parts);
    }
}
@if (totalPages > 1)
{
    <nav class="app-pagination-window" aria-label="Pagination">
        <button type="submit" form="@formId" formaction="@BuildAction(1)" class="app-pagination-window__nav-link"
                aria-label="First page" title="First page" disabled="@(currentPage == 1)">&laquo;</button>
        <button type="submit" form="@formId" formaction="@BuildAction(currentPage - 1)" class="app-pagination-window__nav-link"
                aria-label="Previous page" title="Previous page" disabled="@(currentPage == 1)">&lsaquo;</button>
        <button type="submit" form="@formId" formaction="@BuildAction(currentPage + 1)" class="app-pagination-window__nav-link"
                aria-label="Next page" title="Next page" disabled="@(currentPage == totalPages)">&rsaquo;</button>
        <button type="submit" form="@formId" formaction="@BuildAction(totalPages)" class="app-pagination-window__nav-link"
                aria-label="Last page" title="Last page" disabled="@(currentPage == totalPages)">&raquo;</button>

        <ul class="app-pagination-window__list">
            @foreach (var pageNum in PaginationHelpers.BuildSlidingWindow(currentPage, totalPages))
            {
                if (pageNum == currentPage)
                {
                    <li class="app-pagination-window__item app-pagination-window__item--current">
                        <span aria-current="page">@pageNum</span>
                    </li>
                }
                else
                {
                    <li class="app-pagination-window__item">
                        <button type="submit" form="@formId" formaction="@BuildAction(pageNum)" aria-label="Page @(pageNum)">@pageNum</button>
                    </li>
                }
            }
        </ul>

        <p class="app-pagination-window__summary">Page @currentPage of @totalPages</p>
    </nav>
}
