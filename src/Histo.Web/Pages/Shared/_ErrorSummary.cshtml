@*
    GOV.UK Design System error summary.
    Each entry links to the id of the field it relates to, so activating the link
    moves focus to that input. Key = field id, Value = message.
*@
@model IReadOnlyDictionary<string, string>

@if (Model is { Count: > 0 })
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    @foreach (var error in Model)
                    {
                        <li><a href="#@error.Key">@error.Value</a></li>
                    }
                </ul>
            </div>
        </div>
    </div>
}
