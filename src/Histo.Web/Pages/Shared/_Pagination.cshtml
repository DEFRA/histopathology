@using Histo.Core.Domain
@*
    Shared pagination component: « (First) ‹ (Previous) [sliding block of page numbers,
    e.g. 1-10 then 11-20] › (Next) » (Last), with a "Page X of Y" summary — the legacy
    BSE/DataGridPager numbering style used across every grid in this application.

    Usage (render immediately after </table>):
        <partial name="_Pagination" />

    Requires ViewData["CurrentPage"], ViewData["TotalPages"] and ViewData["SortBase"]
    (plus ViewData["SortColumn"]/["SortDesc"] if the grid is sortable) to have been
    set on the page before the table (see GridPageModel.PopulateGridViewData).

    For grids whose filters are POST-bound rather than query-string bound, use
    _PaginationPost instead — it renders the same control as form-submitting buttons.
*@
@{
    var currentPage = ViewData["CurrentPage"] as int? ?? 1;
    var totalPages  = ViewData["TotalPages"] as int? ?? 1;
    var sortBase    = ViewData["SortBase"]?.ToString() ?? string.Empty;
    var sortColumn  = ViewData["SortColumn"]?.ToString();
    var sortDesc    = ViewData["SortDesc"] as bool? ?? false;

    string BuildHref(int page)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(sortBase))
            parts.Add(sortBase);
        if (!string.IsNullOrEmpty(sortColumn))
        {
            parts.Add($"SortColumn={Uri.EscapeDataString(sortColumn)}");
            parts.Add($"SortDesc={(sortDesc ? "true" : "false")}");
        }
        parts.Add($"PageNumber={page}");
        return "?" + string.Join("&", parts);
    }
}
@if (totalPages > 1)
{
    <nav class="app-pagination-window" aria-label="Pagination">
        <a class="app-pagination-window__nav-link @(currentPage == 1 ? "app-pagination-window__nav-link--disabled" : "")"
           href="@(currentPage == 1 ? "#" : BuildHref(1))" aria-label="First page" title="First page">&laquo;</a>
        <a class="app-pagination-window__nav-link @(currentPage == 1 ? "app-pagination-window__nav-link--disabled" : "")"
           href="@(currentPage == 1 ? "#" : BuildHref(currentPage - 1))" aria-label="Previous page" title="Previous page">&lsaquo;</a>

        <ul class="app-pagination-window__list">
            @foreach (var pageNum in PaginationHelpers.BuildSlidingWindow(currentPage, totalPages))
            {
                if (pageNum == currentPage)
                {
                    <li class="app-pagination-window__item app-pagination-window__item--current">
                        <span aria-current="page">@pageNum</span>
                    </li>
                }
                else
                {
                    <li class="app-pagination-window__item">
                        <a href="@BuildHref(pageNum)" aria-label="Page @(pageNum)">@pageNum</a>
                    </li>
                }
            }
        </ul>

        <a class="app-pagination-window__nav-link @(currentPage == totalPages ? "app-pagination-window__nav-link--disabled" : "")"
           href="@(currentPage == totalPages ? "#" : BuildHref(currentPage + 1))" aria-label="Next page" title="Next page">&rsaquo;</a>
        <a class="app-pagination-window__nav-link @(currentPage == totalPages ? "app-pagination-window__nav-link--disabled" : "")"
           href="@(currentPage == totalPages ? "#" : BuildHref(totalPages))" aria-label="Last page" title="Last page">&raquo;</a>

        <p class="app-pagination-window__summary">Page @currentPage of @totalPages</p>
    </nav>
}
