@*
    GOV.UK error summary for a single page-level save/concurrency failure (not tied to a
    specific field) — e.g. "Failed to save changes. Please try again." or a concurrency
    conflict message. Pass the page model's SaveError string; renders nothing when null/empty.
    Complements _ErrorSummary.cshtml, which renders the field-keyed validation error list.
*@
@model string?

@if (!string.IsNullOrEmpty(Model))
{
    <div class="govuk-error-summary" data-module="govuk-error-summary">
        <div role="alert">
            <h2 class="govuk-error-summary__title">There is a problem</h2>
            <div class="govuk-error-summary__body">
                <ul class="govuk-list govuk-error-summary__list">
                    <li>@Model</li>
                </ul>
            </div>
        </div>
    </div>
}
