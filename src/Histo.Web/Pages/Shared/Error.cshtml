@page
@model Histo.Web.Pages.Shared.ErrorModel
@{
    ViewData["Title"] = "Error";
    ViewData["PageTitle"] = "An Error Occurred";
}

<div class="govuk-error-summary" data-module="govuk-error-summary">
    <div role="alert">
        <h2 class="govuk-error-summary__title">Something went wrong</h2>
        <div class="govuk-error-summary__body">
            <p class="govuk-body">An unexpected error occurred. Please try again or contact support if the problem persists.</p>
            @if (!string.IsNullOrEmpty(Model.RequestId))
            {
                <p class="govuk-body">Request ID: <code>@Model.RequestId</code></p>
            }
        </div>
    </div>
</div>
<a asp-page="/Index" class="govuk-button" data-module="govuk-button">Return to home</a>
