@* _NavPartial.cshtml
   Role-based navigation — replaces the VLAHeader.ascx hyperlink show/hide logic.
   Visible links are determined by the user's GroupName stored in ISessionService.
   Emits <li class="govuk-service-navigation__item"> items only — the enclosing
   <ul id="navigation" class="govuk-service-navigation__list"> lives in _Layout.cshtml.
   Phase 2: Replace @User.Identity?.Name with session group from Entra ID claims.
*@
@inject Histo.Web.Services.ISessionService SessionSvc

@{
    var group = SessionSvc.GroupName;
    bool isHisto = group == "Histopathology User";
    bool isMaint = group == "Maintenance";
    bool isCustomer = group == "Customer" || (!isHisto && !isMaint);
}

@* ── Links available to ALL groups ──────────────────────────────────── *@
<li class="govuk-service-navigation__item">
    <a class="govuk-service-navigation__link" asp-page="/Submissions/ViewSubmissions">View submissions</a>
</li>

@if (isCustomer || isHisto || isMaint)
{
    <li class="govuk-service-navigation__item">
        <a class="govuk-service-navigation__link" asp-page="/Batches/Cassetted">New submission</a>
    </li>
}

@* ── Histopathology User + Maintenance ──────────────────────────────── *@
@if (isHisto || isMaint)
{
    <li class="govuk-service-navigation__item">
        <a class="govuk-service-navigation__link" asp-page="/Batches/BatchesNotReceived">Receive submissions</a>
    </li>
    <li class="govuk-service-navigation__item">
        <a class="govuk-service-navigation__link" asp-page="/Batches/BatchesForEditing">Edit submission status</a>
    </li>
    <li class="govuk-service-navigation__item">
        <a class="govuk-service-navigation__link" asp-page="/Batches/BatchesForDispatch">Enter quality data</a>
    </li>
    <li class="govuk-service-navigation__item">
        <a class="govuk-service-navigation__link" asp-page="/Search/SearchMenu">Search</a>
    </li>
    <li class="govuk-service-navigation__item">
        <a class="govuk-service-navigation__link" asp-page="/QC/QCNotes">QC notes</a>
    </li>
    <li class="govuk-service-navigation__item">
        <a class="govuk-service-navigation__link" asp-page="/Bookings/BookingMenu">Booking</a>
    </li>
    <li class="govuk-service-navigation__item">
        <a class="govuk-service-navigation__link" asp-page="/Archive/ArchiveMenu">Archive</a>
    </li>
    <li class="govuk-service-navigation__item">
        <a class="govuk-service-navigation__link" asp-page="/AuditLog/AuditLogMenu">Audit log</a>
    </li>
}

@* ── Maintenance only ───────────────────────────────────────────────── *@
@if (isMaint)
{
    <li class="govuk-service-navigation__item">
        <a class="govuk-service-navigation__link" asp-page="/Admin/UserMaintenance">User maintenance</a>
    </li>
    <li class="govuk-service-navigation__item">
        <a class="govuk-service-navigation__link" asp-page="/Admin/PickListMaintenance">Pick list maintenance</a>
    </li>
}

@* ── Help — available to all groups ─────────────────────────────────── *@
<li class="govuk-service-navigation__item">
    <a class="govuk-service-navigation__link" asp-page="/Help/Index"
       target="_blank" rel="noreferrer noopener">Help</a>
</li>

