<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Histopathology System</title>
    <link rel="stylesheet" href="~/css/Styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="site-nav">
            <a class="site-title" asp-page="/Index">Histopathology System</a>
            @await Html.PartialAsync("_NavPartial")
        </nav>
        <div class="site-context">
            @await Html.PartialAsync("_UserContextPartial")
        </div>
    </header>

    @if (ViewData["PageTitle"] is string pt)
    {
        <div class="page-title-bar">
            <h1 class="page-title">@pt</h1>
            @if (ViewData["BatchNo"] is string batchNo)
            {
                <span class="context-label">Batch No: @batchNo</span>
            }
        </div>
    }

    <main role="main" class="main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <p>Histopathology System &copy; @DateTime.Now.Year</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
