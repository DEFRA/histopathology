@* _UserContextPartial.cshtml
   Replaces VLAHeader.ascx labels: lblUser, lblLab, lblArea, lblBatchNo, lblSubmission.
   All values come from ISessionService — no direct Session[] access in views.
   Rendered inside a govuk-body-s line in _Layout.cshtml; spans use .app-header-user-item
   for consistent spacing between the User/Group/Area/Sub. No. fields.
*@
@inject Histo.Web.Services.ISessionService SessionSvc

<ul class="app-header-user-list">
    <li class="app-header-user-item">User: @SessionSvc.UserName</li>
    <li class="app-header-user-item">Group: @SessionSvc.GroupName</li>
    @if (!string.IsNullOrEmpty(SessionSvc.UserArea))
    {
        <li class="app-header-user-item">Area: @SessionSvc.UserArea</li>
    }
    @if (SessionSvc.BatchID.HasValue)
    {
        <li class="app-header-user-item">Sub. No: @SessionSvc.BatchID</li>
    }
</ul>


