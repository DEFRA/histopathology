<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phase 1 stub — no source files yet. Implementation begins in Phase 3. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Histo.Reporting</RootNamespace>
    <Description>HTML/PDF report rendering. Replaces 9 Crystal Reports (.rpt) and companion VB classes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- QuestPDF Community Edition — free open-source PDF engine (no native binary required).
         Community licence is declared at runtime via QuestPDF.Settings.License = LicenseType.Community
         in each renderer's static constructor.
         Pin to a specific patch version before production release. -->
    <PackageReference Include="QuestPDF" Version="2024.3.5" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Histo.Infrastructure\Histo.Infrastructure.csproj" />
    <ProjectReference Include="..\Histo.Submissions\Histo.Submissions.csproj" />
  </ItemGroup>

</Project>
