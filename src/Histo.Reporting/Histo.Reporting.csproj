<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phase 1 stub — no source files yet. Implementation begins in Phase 3. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Histo.Reporting</RootNamespace>
    <Description>HTML/PDF report rendering. Replaces 9 Crystal Reports (.rpt) and companion VB classes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- QuestPDF Professional licence is declared at runtime in QuestPdfLicense (module initialiser).
         Pin to a specific patch version before production release. -->
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- QuestPDF 2026.9+ ignores system fonts; Liberation Sans/Mono (SIL OFL) are metric-compatible with Arial/Courier-width text and are auto-registered from the output folder. -->
    <Content Include="Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" Link="Fonts\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Histo.Infrastructure\Histo.Infrastructure.csproj" />
    <ProjectReference Include="..\Histo.Submissions\Histo.Submissions.csproj" />
    <ProjectReference Include="..\Histo.Administration\Histo.Administration.csproj" />
  </ItemGroup>

</Project>
