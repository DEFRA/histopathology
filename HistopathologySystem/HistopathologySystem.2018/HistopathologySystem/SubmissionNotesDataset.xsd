<?xml version="1.0" encoding="utf-8" ?>
<xs:schema id="SubmissionNotes" targetNamespace="http://tempuri.org/SubmissionNotes.xsd" elementFormDefault="qualified"
	attributeFormDefault="qualified" xmlns="http://tempuri.org/SubmissionNotes.xsd" xmlns:mstns="http://tempuri.org/SubmissionNotes.xsd"
	xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
	<xs:element name="SubmissionNotes" msdata:IsDataSet="true">
		<xs:complexType>
			<xs:choice maxOccurs="unbounded">
				<xs:element name="Submission">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="SubmissionNumber" type="xs:string" minOccurs="0" />
							<xs:element name="SubmissionComments" type="xs:string" minOccurs="0" />
							<xs:element name="SubmissionStatusComment" type="xs:string" minOccurs="0" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="SubmissionTissues">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="TissueCode" type="xs:string" minOccurs="0" />
							<xs:element name="TissueComment" type="xs:string" minOccurs="0" />
							<xs:element name="TissueArchiveComment" type="xs:string" minOccurs="0" />
							<xs:element name="SenderRef" type="xs:string" minOccurs="0" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="SubmissionBlocks">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="SenderRef" type="xs:string" minOccurs="0" />
							<xs:element name="BlockRef" type="xs:string" minOccurs="0" />
							<xs:element name="BlockComment" type="xs:string" minOccurs="0" />
							<xs:element name="BlockArchiveComment" type="xs:string" minOccurs="0" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="BlockAntibodies">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="BlockRef" type="xs:string" minOccurs="0" />
							<xs:element name="Test" type="xs:string" minOccurs="0" />
							<xs:element name="TestComment" type="xs:string" minOccurs="0" />
							<xs:element name="TestArchiveComment" type="xs:string" minOccurs="0" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="BlockHistology">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="BlockRef" type="xs:string" minOccurs="0" />
							<xs:element name="Test" type="xs:string" minOccurs="0" />
							<xs:element name="TestComment" type="xs:string" minOccurs="0" />
							<xs:element name="TestArchiveComment" type="xs:string" minOccurs="0" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="BlockSpecialStain">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="BlockRef" type="xs:string" minOccurs="0" />
							<xs:element name="Test" type="xs:string" minOccurs="0" />
							<xs:element name="TestComment" type="xs:string" minOccurs="0" />
							<xs:element name="TestArchiveComment" type="xs:string" minOccurs="0" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:choice>
		</xs:complexType>
	</xs:element>
</xs:schema>